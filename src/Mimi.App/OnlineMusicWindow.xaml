<Window x:Class="Mimi.OnlineMusicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Width="1180"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource MimiUiFontFamily}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" FontSize="15" FontWeight="Bold"/>
                    <TextBlock x:Name="HeaderSubtitle" FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="OpenInBrowserButton" DockPanel.Dock="Right" Padding="12,6"
                        VerticalAlignment="Center" Click="OpenInBrowser_Click"
                        Content="{Binding Loc[Online_OpenInBrowser]}"
                        AutomationProperties.Name="{Binding Loc[Online_OpenInBrowser]}"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>

            <Border x:Name="StatusPanel" Background="{StaticResource AppBackgroundBrush}"
                    Padding="28">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="620">
                    <TextBlock x:Name="StatusHeadline" FontSize="16" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="StatusDetail" FontSize="12" Margin="0,10,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{StaticResource TextMutedBrush}"/>
                    <ProgressBar x:Name="StatusProgress" Height="3" Margin="0,16,0,0"
                                 IsIndeterminate="True"/>
                    <Button x:Name="RuntimeInstallButton" Margin="0,18,0,0"
                            HorizontalAlignment="Center" Padding="14,8"
                            Visibility="Collapsed" Click="RuntimeInstall_Click"
                            Content="{Binding Loc[Online_InstallRuntime]}"
                            AutomationProperties.Name="{Binding Loc[Online_InstallRuntime]}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
