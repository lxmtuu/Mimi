<Window x:Class="Mimi.StageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mimi.Controls"
        Title="Mimi Stage"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource MimiUiFontFamily}">
    <Grid Background="{StaticResource StageGradientBrush}">
        <Rectangle Fill="{StaticResource StageAccentGlowBrush}"
                   Opacity="0.8" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource StageHotGlowBrush}"
                   Opacity="0.74" IsHitTestVisible="False"/>
        <Rectangle Fill="{StaticResource StageVignetteBrush}"
                   Opacity="0.52" IsHitTestVisible="False"/>

        <controls:VisualizerView x:Name="StageVisualizer"
                                  PrimaryColor="{DynamicResource AccentColor}"
                                  SecondaryColor="{DynamicResource AccentSecondaryColor}"
                                  PeakColor="{DynamicResource AccentHotColor}"
                                  BaselineColor="{DynamicResource TextMutedColor}"
                                  Margin="36"
                                  IsHitTestVisible="False"/>

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="760"
                Padding="28,16"
                CornerRadius="18"
                Background="{StaticResource StageOverlayBrush}"
                BorderBrush="{StaticResource AccentDecorSoftBrush}"
                BorderThickness="1"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="28" ShadowDepth="0" Opacity="0.18"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="StageTitle"
                           Text="{Binding Loc[NowPlaying_ChooseSong]}"
                           FontSize="34"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="{DynamicResource AppBackgroundColor}" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.45"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="StageSubtitle"
                           Text="{Binding Loc[NowPlaying_NextFavoriteWaiting]}"
                           Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="15"
                           TextAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="StageMetricsText"
                   Text="0 FPS · 0.00 ms"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Margin="0,24,28,0"
                   Foreground="{StaticResource TextFaintBrush}"
                   FontSize="12"
                   IsHitTestVisible="False"/>
        <TextBlock Text="{Binding Loc[Stage_Hint]}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,24"
                   Foreground="{StaticResource TextFaintBrush}"
                   FontSize="12"
                   IsHitTestVisible="False"/>
    </Grid>
</Window>
