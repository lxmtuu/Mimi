<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Color values are published by ThemeService from Core theme
         definitions. These shared brushes deliberately bind dynamically so
         a live theme change reaches controls that reference them. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{DynamicResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{DynamicResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="RaisedBackgroundBrush" Color="{DynamicResource RaisedBackgroundColor}"/>
    <SolidColorBrush x:Key="SunkenBackgroundBrush" Color="{DynamicResource SunkenBackgroundColor}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{DynamicResource ControlBackgroundColor}"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="{DynamicResource SelectedBackgroundColor}"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{DynamicResource HeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource DividerColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{DynamicResource AccentSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentHotBrush" Color="{DynamicResource AccentHotColor}"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="{DynamicResource OnAccentColor}"/>
    <SolidColorBrush x:Key="AccentDecorSoftBrush" Color="{DynamicResource AccentDecorSoftColor}"/>
    <SolidColorBrush x:Key="AccentDecorMediumBrush" Color="{DynamicResource AccentDecorMediumColor}"/>
    <SolidColorBrush x:Key="AccentDecorStrongBrush" Color="{DynamicResource AccentDecorStrongColor}"/>
    <SolidColorBrush x:Key="AccentDecorVividBrush" Color="{DynamicResource AccentDecorVividColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextStrongBrush" Color="{DynamicResource TextStrongColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="{DynamicResource TextFaintColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{DynamicResource TextDisabledColor}"/>

    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{DynamicResource WarningTextColor}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{DynamicResource WarningBackgroundColor}"/>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{DynamicResource WarningBorderColor}"/>
    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="{DynamicResource DangerBackgroundColor}"/>
    <SolidColorBrush x:Key="StageOverlayBrush" Color="{DynamicResource StageOverlayColor}"/>

    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource HeroGradientStartColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource HeroGradientMiddleColor}" Offset="0.55"/>
        <GradientStop Color="{DynamicResource HeroGradientEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StageGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource StageGradientStartColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource StageGradientMiddleColor}" Offset="0.55"/>
        <GradientStop Color="{DynamicResource StageGradientEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource CoverGradientStartColor}" Offset="0"/>
        <GradientStop Color="{DynamicResource CoverGradientEndColor}" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
