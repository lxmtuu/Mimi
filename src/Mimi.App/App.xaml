<Application x:Class="Mimi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- First, because everything below it references the key. -->
            <ResourceDictionary Source="Themes/FocusVisual.xaml"/>
            <ResourceDictionary Source="Themes/ThemeBrushes.xaml"/>
            <ResourceDictionary Source="Themes/ControlStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- The bundled family makes Vietnamese diacritics render the same
             on every Windows machine. Segoe fallbacks retain symbols that
             Be Vietnam Pro does not contain, such as ♫ and ⚠. -->
        <FontFamily x:Key="MimiUiFontFamily">./Assets/Fonts/#Be Vietnam Pro, Segoe UI Variable Text, Segoe UI, Segoe UI Symbol</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource MimiFocusVisualStyle}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="10"/>
                            <!-- The wash sits above the background but under the
                                 content, so an accent button keeps its own colour
                                 and the label stays crisp. -->
                            <Border x:Name="HoverWash" CornerRadius="10"
                                    Background="{DynamicResource HoverSurfaceStrongBrush}"
                                    Opacity="0"/>
                            <Border x:Name="PressWash" CornerRadius="10"
                                    Background="{DynamicResource ScrimBrush}"
                                    Opacity="0"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0"/>
                                <Setter TargetName="PressWash" Property="Opacity" Value="0.28"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HoverWash" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Stock templates that survive (menu popups, edit controls)
             read these system keys; pointing them at theme colours keeps
             the app from flashing light grey inside a dark theme. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource SelectedBackgroundColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextStrongColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource SelectedBackgroundColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextStrongColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="{DynamicResource AccentColor}"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{DynamicResource TextPrimaryColor}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
