<Application x:Class="Mimi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/ThemeBrushes.xaml"/>
            <ResourceDictionary Source="Themes/ControlStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- The bundled family makes Vietnamese diacritics render the same
             on every Windows machine. Segoe fallbacks retain symbols that
             Be Vietnam Pro does not contain, such as ♫ and ⚠. -->
        <FontFamily x:Key="MimiUiFontFamily">./Assets/Fonts/#Be Vietnam Pro, Segoe UI Variable Text, Segoe UI, Segoe UI Symbol</FontFamily>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style x:Key="MimiFocusVisualStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2" CornerRadius="12" Margin="-3"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
        </Style>
        <!-- The API key box is the only PasswordBox in the app. It is styled
             explicitly so it reads as part of the dark card rather than as a
             stock white Windows control. -->
        <Style TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
