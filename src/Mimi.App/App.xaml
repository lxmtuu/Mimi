<Application x:Class="Mimi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- The bundled family makes Vietnamese diacritics render the same
             on every Windows machine. Segoe fallbacks retain symbols that
             Be Vietnam Pro does not contain, such as ♫ and ⚠. -->
        <FontFamily x:Key="MimiUiFontFamily">./Assets/Fonts/#Be Vietnam Pro, Segoe UI Variable Text, Segoe UI, Segoe UI Symbol</FontFamily>
        <Color x:Key="BgColor">#0B101B</Color>
        <Color x:Key="PanelColor">#121C2B</Color>
        <Color x:Key="AccentColor">#47E6D0</Color>
        <Color x:Key="PinkColor">#FF8FCB</Color>
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="PinkBrush" Color="{StaticResource PinkColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#9FB2C8"/>
        <SolidColorBrush x:Key="TextFaintBrush" Color="#94A9C2"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
        </Style>
        <Style x:Key="MimiFocusVisualStyle">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="2" CornerRadius="12" Margin="-3"
                                SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F3F7FF"/>
            <Setter Property="Background" Value="#203044"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
            <Setter Property="Foreground" Value="#EAF2FC"/>
            <Setter Property="Margin" Value="0,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="FontFamily" Value="{StaticResource MimiUiFontFamily}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
        </Style>
    </Application.Resources>
</Application>
