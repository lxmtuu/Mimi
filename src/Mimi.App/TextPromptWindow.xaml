<Window x:Class="Mimi.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mimi" Width="440" Height="215"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource MimiUiFontFamily}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptLabel" TextWrapping="Wrap" FontSize="13"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" Margin="0,14,0,0"
                 Height="36" Padding="10,0" VerticalContentAlignment="Center"
                 Background="{StaticResource RaisedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                 AutomationProperties.Name="{Binding Loc[Prompt_TextValue]}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="{Binding Loc[Common_Cancel]}" IsCancel="True" MinWidth="88"
                    AutomationProperties.Name="{Binding Loc[Common_Cancel]}"/>
            <Button Content="{Binding Loc[Common_Ok]}" IsDefault="True" MinWidth="88"
                    Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                    FontWeight="Bold" Click="OkButton_Click"
                    AutomationProperties.Name="{Binding Loc[Common_Ok]}"/>
        </StackPanel>
    </Grid>
</Window>
