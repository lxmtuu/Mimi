<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Mimi</AssemblyName>
    <RootNamespace>Mimi</RootNamespace>
    <Product>Mimi</Product>
    <Title>Mimi</Title>
    <Description>Mimi - a personal desktop music player.</Description>
    <Version>0.4.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\mimi.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mimi.Core\Mimi.Core.csproj" />
    <ProjectReference Include="..\Mimi.Audio\Mimi.Audio.csproj" />
    <ProjectReference Include="..\Mimi.Library\Mimi.Library.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
</Project>
