                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsLibraryReady}" Value="True"/>
                                            <Condition Binding="{Binding HasVisibleTracks}" Value="False"/>
                                            <Condition Binding="{Binding IsScanning}" Value="False"/>
