<Window x:Class="Mimi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mimi.Controls"
        xmlns:behaviors="clr-namespace:Mimi.Behaviors"
        Title="Mimi" Height="820" Width="1320" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        Foreground="#F3F7FF">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <StreamGeometry x:Key="HomeIconGeometry">M3,11 L12,3 L21,11 L19,11 L19,21 L13.5,21 L13.5,15 L10.5,15 L10.5,21 L5,21 L5,11 Z</StreamGeometry>
        <StreamGeometry x:Key="MusicIconGeometry">M9,18.5 A3,2.5 0 1 1 6,16 L6,5 L20,3 L20,15.5 A3,2.5 0 1 1 17,13 L17,6.2 L9,7.8 Z</StreamGeometry>
        <StreamGeometry x:Key="HeartIconGeometry">M12,21 C7,16.5 3,13.2 3,9.3 C3,6.4 5.1,4.5 7.6,4.5 C9.4,4.5 11,5.5 12,7 C13,5.5 14.6,4.5 16.4,4.5 C18.9,4.5 21,6.4 21,9.3 C21,13.2 17,16.5 12,21 Z</StreamGeometry>
        <StreamGeometry x:Key="HistoryIconGeometry">M12,3 A9,9 0 1 1 3.2,9 L1.7,9 L5.2,4.7 L8.7,9 L5.3,9 A7,7 0 1 0 12,5 Z M11,8 L13,8 L13,12.2 L16.3,14 L15.4,15.8 L11,13.4 Z</StreamGeometry>
        <StreamGeometry x:Key="PlusIconGeometry">M10,4 H14 V10 H20 V14 H14 V20 H10 V14 H4 V10 H10 Z</StreamGeometry>
        <StreamGeometry x:Key="FolderIconGeometry">M3,6 A2,2 0 0 1 5,4 H10 L12,6 H19 A2,2 0 0 1 21,8 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z</StreamGeometry>
        <StreamGeometry x:Key="PreviousIconGeometry">M6,5 H8 V19 H6 Z M20,5 L9.5,12 L20,19 Z</StreamGeometry>
        <StreamGeometry x:Key="NextIconGeometry">M16,5 H18 V19 H16 Z M4,5 L14.5,12 L4,19 Z</StreamGeometry>
        <StreamGeometry x:Key="PlayIconGeometry">M8,5 L19,12 L8,19 Z</StreamGeometry>
        <StreamGeometry x:Key="PauseIconGeometry">M7,5 H10.5 V19 H7 Z M13.5,5 H17 V19 H13.5 Z</StreamGeometry>
        <StreamGeometry x:Key="ExpandIconGeometry">M4,9 V4 H9 V6.5 H6.5 V9 Z M15,4 H20 V9 H17.5 V6.5 H15 Z M4,15 H6.5 V17.5 H9 V20 H4 Z M17.5,15 H20 V20 H15 V17.5 H17.5 Z</StreamGeometry>

        <Style x:Key="IconPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ModeButtonBaseStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#203044"/>
            <Setter Property="Foreground" Value="#F3F7FF"/>
        </Style>
        <Style x:Key="SpectrumModeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModeButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualizerMode}" Value="{x:Static controls:VisualizerDisplayMode.NeonSpectrum}">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#07151B"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TwinWaveModeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModeButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualizerMode}" Value="{x:Static controls:VisualizerDisplayMode.TwinWave}">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#07151B"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HaloModeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModeButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualizerMode}" Value="{x:Static controls:VisualizerDisplayMode.HaloCircle}">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="#07151B"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9FB2C8"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource PinkBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18"
          behaviors:FileDropBehavior.Command="{Binding AddDroppedPathsCommand}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="6,2,6,18">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Border Width="42" Height="42" CornerRadius="14" Background="{StaticResource AccentBrush}">
                    <TextBlock Text="M" Foreground="#07151B" FontSize="25" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MIMI" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="MUSIC UNIVERSE" FontSize="10" Foreground="#9FB2C8"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="LOCAL PLAYER  |  YOUR MUSIC, YOUR WORLD" Foreground="#9FB2C8"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="180"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="270" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="12" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="YOUR SPACE" Foreground="#9FB2C8" FontSize="11" Margin="8,10,0,14"/>
                        <Button Command="{Binding ShowHomeCommand}" HorizontalContentAlignment="Left"
                                Background="#203A48" AutomationProperties.Name="Home">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource HomeIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="Home" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowLibraryCommand}" HorizontalContentAlignment="Left"
                                AutomationProperties.Name="My library">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource MusicIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="My Library" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleFavoritesViewCommand}" HorizontalContentAlignment="Left"
                                AutomationProperties.Name="Favorites">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource HeartIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="Favorites" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowRecentCommand}" HorizontalContentAlignment="Left"
                                AutomationProperties.Name="Recently played">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource HistoryIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="Recently played" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="PLAYLISTS" Foreground="#9FB2C8" FontSize="11" Margin="8,26,0,8"/>
                        <Button Command="{Binding AddFilesCommand}" HorizontalContentAlignment="Left"
                                AutomationProperties.Name="Add music files">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PlusIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="Add music files" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddFolderCommand}" HorizontalContentAlignment="Left"
                                AutomationProperties.Name="Scan a folder">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FolderIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="Scan a folder" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="#172638" CornerRadius="12" Padding="12" Margin="2,14,2,2">
                        <StackPanel>
                            <TextBlock Text="MIMI BETA" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                            <TextBlock Text="The first step toward your own anime music universe." TextWrapping="Wrap" Foreground="#AEC2D6" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="20" Padding="24" Margin="0,0,0,16" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#183E4D" Offset="0"/>
                            <GradientStop Color="#252542" Offset="0.55"/>
                            <GradientStop Color="#171A2A" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Left">
                            <TextBlock Text="WELCOME TO YOUR UNIVERSE" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                            <TextBlock Text="Every song tells&#10;a different story." FontSize="30" FontWeight="Bold" Margin="0,12,0,8"/>
                            <TextBlock Text="Build your library. Find your rhythm. Make this space yours."
                                       Foreground="#B7C9DB" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14"/>
                            <Button Command="{Binding AddFilesCommand}" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}" Foreground="#07151B"
                                    FontWeight="Bold" AutomationProperties.Name="Add your first songs">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource PlusIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                    <TextBlock Text="Add your first songs" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Canvas HorizontalAlignment="Right" Width="145" Margin="0,0,8,0" IsHitTestVisible="False">
                            <Ellipse Width="130" Height="130" Stroke="#6547E6D0" StrokeThickness="1" Canvas.Left="7" Canvas.Top="8"/>
                            <Ellipse Width="100" Height="100" Stroke="#8847E6D0" StrokeThickness="2" Canvas.Left="22" Canvas.Top="23"/>
                            <Ellipse Width="68" Height="68" Fill="#2247E6D0" Stroke="#FF47E6D0" StrokeThickness="1.5" Canvas.Left="38" Canvas.Top="39"/>
                            <TextBlock Text="♫" FontSize="38" Foreground="{StaticResource AccentBrush}" Canvas.Left="55" Canvas.Top="48"/>
                            <Ellipse Width="8" Height="8" Fill="{StaticResource PinkBrush}" Canvas.Left="3" Canvas.Top="34"/>
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Canvas.Left="119" Canvas.Top="110"/>
                        </Canvas>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Margin="2,0,2,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding SectionTitle}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TrackCountLabel}" Foreground="#9FB2C8" FontSize="12" Margin="0,4,0,0"/>
                        <StackPanel Margin="0,8,16,0" Width="330"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding ScanStatusLabel}" Foreground="#B7C7DA" FontSize="11"
                                           TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                <Button Content="Cancel" Command="{Binding CancelScanCommand}" DockPanel.Dock="Right"
                                        Padding="8,3" Margin="8,0,0,0" FontSize="11"
                                        AutomationProperties.Name="Cancel library scan"/>
                            </DockPanel>
                            <ProgressBar Minimum="0" Maximum="100" Height="5" Margin="0,6,0,0"
                                         Value="{Binding ScanProgressPercent, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Width="190" MinWidth="140" Height="34" VerticalContentAlignment="Center"
                             Background="#172638" Foreground="White" BorderThickness="0" Padding="10,0"
                             ToolTip="Search songs" AutomationProperties.Name="Search songs"/>
                </DockPanel>

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="8">
                    <ListView x:Name="TrackList" ItemsSource="{Binding TracksView}"
                              SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                              Background="Transparent" BorderThickness="0"
                              Foreground="#EAF2FC" AutomationProperties.Name="Track list">
                        <ListView.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveSelectedTrackCommand}"/>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding PlayTrackCommand}"
                                          CommandParameter="{Binding SelectedTrack}"/>
                        </ListView.InputBindings>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding PlacementTarget.DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.SelectedTrack, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                                    <MenuItem.Style>
                                        <Style TargetType="{x:Type MenuItem}">
                                            <Setter Property="Header" Value="Add to favorites"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlacementTarget.DataContext.SelectedTrack.IsFavorite, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Value="True">
                                                    <Setter Property="Header" Value="Remove from favorites"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                </MenuItem>
                                <MenuItem Header="Remove from library"
                                          Command="{Binding PlacementTarget.DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.SelectedTrack, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                        <ListView.Resources>
                            <Style TargetType="{x:Type GridViewColumnHeader}">
                                <Setter Property="Background" Value="#1A2A3D"/>
                                <Setter Property="Foreground" Value="#47E6D0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="10,9"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="♥" Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding FavoriteGlyph}"
                                                    ToolTip="{Binding FavoriteToolTip}"
                                                    AutomationProperties.Name="{Binding FavoriteToolTip}"
                                                    Style="{StaticResource FavoriteButtonStyle}"
                                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="TITLE" Width="205" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="ARTIST" Width="135" DisplayMemberBinding="{Binding Artist}"/>
                                <GridViewColumn Header="ALBUM" Width="135" DisplayMemberBinding="{Binding Album}"/>
                                <GridViewColumn Header="TIME" Width="64" DisplayMemberBinding="{Binding DurationLabel}"/>
                                <GridViewColumn Header="FORMAT" Width="76" DisplayMemberBinding="{Binding Format}"/>
                                <GridViewColumn Header="" Width="36">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PlaybackStatus}" Foreground="#FFB020"
                                                       ToolTip="This file could not be played"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}">
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#EAF2FC"/>
                                <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="NOW PLAYING" Foreground="#9FB2C8" FontSize="11"/>
                        <Border Height="210" Margin="0,14,0,16" CornerRadius="16" ClipToBounds="True">
                            <Grid>
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#235D6A" Offset="0"/>
                                        <GradientStop Color="#302A55" Offset="1"/>
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <Image Source="{Binding CurrentCoverArtPath}" Stretch="UniformToFill"
                                       Opacity="0.38" IsHitTestVisible="False"/>
                                <Ellipse Width="150" Height="150" Stroke="#6647E6D0" StrokeThickness="1.5"/>
                                <Ellipse Width="110" Height="110" Stroke="#AA47E6D0" StrokeThickness="1.5"/>
                                <TextBlock Text="♫" FontSize="62" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <controls:VisualizerView x:Name="MainVisualizer" Mode="{Binding VisualizerMode, Mode=OneWay}"
                                                         Margin="14,10,14,24" IsHitTestVisible="False"/>
                                <TextBlock Text="MUSIC IN MOTION" FontSize="9" Foreground="#B7C9DB"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="17" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding NowPlayingSubtitle}" Foreground="#9FB2C8"
                                   FontSize="12" Margin="0,5,0,18" TextWrapping="Wrap"/>
                        <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100"
                                Value="{Binding ProgressPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsMoveToPointEnabled="True" AutomationProperties.Name="Playback position"/>
                        <DockPanel Margin="0,2,0,16">
                            <TextBlock Text="{Binding CurrentTimeLabel}" Foreground="#9FB2C8" FontSize="10" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding DurationLabel}" Foreground="#9FB2C8" FontSize="10" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Command="{Binding PreviousCommand}" Padding="12,10"
                                    AutomationProperties.Name="Previous track">
                                <Path Data="{StaticResource PreviousIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                            </Button>
                            <Button Command="{Binding PlayPauseCommand}" Background="{StaticResource AccentBrush}"
                                    Foreground="#07151B" Padding="18,10"
                                    AutomationProperties.Name="Play or pause">
                                <Grid Width="20" Height="20">
                                    <Path Data="{StaticResource PlayIconGeometry}">
                                        <Path.Style>
                                            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathStyle}">
                                                <Setter Property="Width" Value="20"/>
                                                <Setter Property="Height" Value="20"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Data="{StaticResource PauseIconGeometry}">
                                        <Path.Style>
                                            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathStyle}">
                                                <Setter Property="Width" Value="20"/>
                                                <Setter Property="Height" Value="20"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                            <Button Command="{Binding NextCommand}" Padding="12,10"
                                    AutomationProperties.Name="Next track">
                                <Path Data="{StaticResource NextIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="VOLUME" Foreground="#9FB2C8" FontSize="10" Margin="4,22,0,5"/>
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Volume"/>
                        <Border Background="#172638" CornerRadius="10" Padding="10" Margin="0,18,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="STAGE ENGINE" Foreground="{StaticResource PinkBrush}" FontSize="10" FontWeight="Bold" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding VisualizerMetricsLabel}" Foreground="#9FB2C8" FontSize="10" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <UniformGrid Columns="3" Margin="0,8,0,0">
                                    <Button Content="Spectrum" Command="{Binding SelectSpectrumModeCommand}"
                                            Style="{StaticResource SpectrumModeButtonStyle}"
                                            AutomationProperties.Name="Neon Spectrum visualizer mode"/>
                                    <Button Content="Twin Wave" Command="{Binding SelectTwinWaveModeCommand}"
                                            Style="{StaticResource TwinWaveModeButtonStyle}"
                                            AutomationProperties.Name="Twin Wave visualizer mode"/>
                                    <Button Content="Halo" Command="{Binding SelectHaloModeCommand}"
                                            Style="{StaticResource HaloModeButtonStyle}"
                                            AutomationProperties.Name="Halo Circle visualizer mode"/>
                                </UniformGrid>
                                <Button Command="{Binding ToggleStageCommand}" Background="{StaticResource AccentBrush}" Foreground="#07151B"
                                        FontWeight="Bold" Padding="10,8" Margin="2,8,2,2"
                                        AutomationProperties.Name="Open or close fullscreen Stage">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource ExpandIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                        <TextBlock Text="Open Stage (F11)" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="4,14,4,0">
            <TextBlock Text="MIMI  |  EARLY DEVELOPMENT BUILD" Foreground="#94A9C2" FontSize="10" DockPanel.Dock="Left"/>
            <TextBlock Text="A personal music space" Foreground="#94A9C2" FontSize="10" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
