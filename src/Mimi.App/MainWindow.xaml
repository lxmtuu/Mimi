                                               Stretch="Uniform"
                                               AutomationProperties.Name="{Binding Loc[Mascot_Automation]}"/>
                                    </Border>
                                    <TextBlock Text="{Binding AppVersionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
