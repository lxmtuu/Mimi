<Window x:Class="Mimi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mimi.Controls"
        xmlns:effects="clr-namespace:Mimi.Effects"
        xmlns:behaviors="clr-namespace:Mimi.Behaviors"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:vm="clr-namespace:Mimi.ViewModels"
        Title="Mimi" Icon="pack://application:,,,/Assets/mimi.ico"
        Height="820" Width="1320" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource MimiUiFontFamily}"
        behaviors:WindowPlacementBehavior.Placement="{Binding WindowPlacement, Mode=TwoWay}"
        behaviors:WindowPlacementBehavior.IsEnabled="{Binding RestoreWindowPlacement}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <StreamGeometry x:Key="HomeIconGeometry">M3,11 L12,3 L21,11 L19,11 L19,21 L13.5,21 L13.5,15 L10.5,15 L10.5,21 L5,21 L5,11 Z</StreamGeometry>
        <StreamGeometry x:Key="MusicIconGeometry">M9,18.5 A3,2.5 0 1 1 6,16 L6,5 L20,3 L20,15.5 A3,2.5 0 1 1 17,13 L17,6.2 L9,7.8 Z</StreamGeometry>
        <StreamGeometry x:Key="HeartIconGeometry">M12,21 C7,16.5 3,13.2 3,9.3 C3,6.4 5.1,4.5 7.6,4.5 C9.4,4.5 11,5.5 12,7 C13,5.5 14.6,4.5 16.4,4.5 C18.9,4.5 21,6.4 21,9.3 C21,13.2 17,16.5 12,21 Z</StreamGeometry>
        <StreamGeometry x:Key="HistoryIconGeometry">M12,3 A9,9 0 1 1 3.2,9 L1.7,9 L5.2,4.7 L8.7,9 L5.3,9 A7,7 0 1 0 12,5 Z M11,8 L13,8 L13,12.2 L16.3,14 L15.4,15.8 L11,13.4 Z</StreamGeometry>
        <StreamGeometry x:Key="RadioIconGeometry">M5,8 L18,3 L18.8,4.7 L8,8 Z M4,10 H20 V20 H4 Z M6,12 H12 V18 H6 Z M9,13.4 A1.8,1.8 0 1 1 9,17 A1.8,1.8 0 1 1 9,13.4 Z M14,12.2 H18 V13.7 H14 Z M14,15 H18 V16.5 H14 Z</StreamGeometry>
        <StreamGeometry x:Key="YouTubeIconGeometry">M3,6 A2.5,2.5 0 0 1 5.5,3.5 H18.5 A2.5,2.5 0 0 1 21,6 V18 A2.5,2.5 0 0 1 18.5,20.5 H5.5 A2.5,2.5 0 0 1 3,18 Z M10,8.5 L16,12 L10,15.5 Z</StreamGeometry>
        <StreamGeometry x:Key="OnlineMusicIconGeometry">M12,2 A10,10 0 1 1 12,22 A10,10 0 1 1 12,2 Z M10,7.6 L16.6,12 L10,16.4 Z</StreamGeometry>
        <StreamGeometry x:Key="PlusIconGeometry">M10,4 H14 V10 H20 V14 H14 V20 H10 V14 H4 V10 H10 Z</StreamGeometry>
        <StreamGeometry x:Key="FolderIconGeometry">M3,6 A2,2 0 0 1 5,4 H10 L12,6 H19 A2,2 0 0 1 21,8 V18 A2,2 0 0 1 19,20 H5 A2,2 0 0 1 3,18 Z</StreamGeometry>
        <StreamGeometry x:Key="PlaylistIconGeometry">M3,5 H14 V7 H3 Z M3,10 H14 V12 H3 Z M3,15 H9 V17 H3 Z M16,14 L21,17 L16,20 Z</StreamGeometry>
        <StreamGeometry x:Key="SettingsIconGeometry">M4,6 H10 V4 H12 V6 H20 V8 H12 V10 H10 V8 H4 Z M4,16 H14 V14 H16 V16 H20 V18 H16 V20 H14 V18 H4 Z</StreamGeometry>
        <StreamGeometry x:Key="PreviousIconGeometry">M6,5 H8 V19 H6 Z M20,5 L9.5,12 L20,19 Z</StreamGeometry>
        <StreamGeometry x:Key="NextIconGeometry">M16,5 H18 V19 H16 Z M4,5 L14.5,12 L4,19 Z</StreamGeometry>
        <StreamGeometry x:Key="PlayIconGeometry">M8,5 L19,12 L8,19 Z</StreamGeometry>
        <StreamGeometry x:Key="PauseIconGeometry">M7,5 H10.5 V19 H7 Z M13.5,5 H17 V19 H13.5 Z</StreamGeometry>
        <DrawingImage x:Key="TaskbarPreviousImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource PreviousIconGeometry}"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarPlayImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource PlayIconGeometry}"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarPauseImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource PauseIconGeometry}"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="TaskbarNextImage">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="{StaticResource TextPrimaryBrush}" Geometry="{StaticResource NextIconGeometry}"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <StreamGeometry x:Key="ExpandIconGeometry">M4,9 V4 H9 V6.5 H6.5 V9 Z M15,4 H20 V9 H17.5 V6.5 H15 Z M4,15 H6.5 V17.5 H9 V20 H4 Z M17.5,15 H20 V20 H15 V17.5 H17.5 Z</StreamGeometry>
        <StreamGeometry x:Key="SearchIconGeometry">M10,2 A8,8 0 0 1 10,18 A8,8 0 0 1 10,2 Z M10,4.5 A5.5,5.5 0 0 0 10,15.5 A5.5,5.5 0 0 0 10,4.5 Z M15.2,13.8 L21,19.6 L19.6,21 L13.8,15.2 Z</StreamGeometry>
        <StreamGeometry x:Key="EditIconGeometry">M3,17.2 V21 H6.8 L17.9,9.9 L14.1,6.1 Z M20.7,7 L17,3.3 C16.6,2.9 16,2.9 15.6,3.3 L13.2,5.7 L18.3,10.8 L20.7,8.4 C21.1,8 21.1,7.4 20.7,7 Z</StreamGeometry>
        <StreamGeometry x:Key="DeleteIconGeometry">M9,3 H15 L16,5 H20 V7 H4 V5 H8 Z M6,9 H18 L17.3,19.2 A2,2 0 0 1 15.3,21 H8.7 A2,2 0 0 1 6.7,19.2 Z M10,10 H11.5 V17 H10 Z M12.5,10 H14 V17 H12.5 Z</StreamGeometry>
        <StreamGeometry x:Key="ShuffleIconGeometry">M3,6.5 H14 V4 L21,8 L14,12 V9.5 H3 Z M21,14.5 H10 V12 L3,16 L10,20 V17.5 H21 Z</StreamGeometry>
        <StreamGeometry x:Key="RepeatIconGeometry">M17,3 L21,7 L17,11 V8.5 H8 A2.5,2.5 0 0 0 5.5,11 V12 H3 V11 A5,5 0 0 1 8,6 H17 Z M7,21 L3,17 L7,13 V15.5 H16 A2.5,2.5 0 0 0 18.5,13 V12 H21 V13 A5,5 0 0 1 16,18 H7 Z</StreamGeometry>
        <StreamGeometry x:Key="SpeakerIconGeometry">M4,9 V15 H8 L13,19 V5 L8,9 Z M16,9 C17.2,10.6 17.2,13.4 16,15 L14.8,13.8 C15.5,12.7 15.5,11.3 14.8,10.2 Z M18.5,6.5 C21,9.5 21,14.5 18.5,17.5 L17.2,16.2 C19,13.8 19,10.2 17.2,7.8 Z</StreamGeometry>
        <StreamGeometry x:Key="FilterIconGeometry">M3,5 H21 L14,12.6 V20 L10,17.4 V12.6 Z</StreamGeometry>
        <StreamGeometry x:Key="ChevronDownIconGeometry">M6,9.4 L12,15.4 L18,9.4 L19.4,10.8 L12,18.2 L4.6,10.8 Z</StreamGeometry>
        <StreamGeometry x:Key="SpeakerMutedIconGeometry">M4,9 V15 H8 L13,19 V5 L8,9 Z M16.5,9 L18,10.5 L19.5,9 L21,10.5 L19.5,12 L21,13.5 L19.5,15 L18,13.5 L16.5,15 L15,13.5 L16.5,12 L15,10.5 Z</StreamGeometry>

        <Style x:Key="IconPathStyle" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="NavSectionRuleStyle" TargetType="{x:Type Border}">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
            <Setter Property="Margin" Value="9,8,9,8"/>
        </Style>
        <Style x:Key="NavLibraryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ActiveView}" Value="{x:Static vm:LibraryViewMode.Library}"/>
                        <Condition Binding="{Binding IsSettingsOpen}" Value="False"/>
                        <Condition Binding="{Binding IsRadioOpen}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavFavoritesButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ActiveView}" Value="{x:Static vm:LibraryViewMode.Favorites}"/>
                        <Condition Binding="{Binding IsSettingsOpen}" Value="False"/>
                        <Condition Binding="{Binding IsRadioOpen}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavRecentButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding ActiveView}" Value="{x:Static vm:LibraryViewMode.Recent}"/>
                        <Condition Binding="{Binding IsSettingsOpen}" Value="False"/>
                        <Condition Binding="{Binding IsRadioOpen}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavRadioButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRadioOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavOnlineButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOnlineOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavYouTubeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsYouTubeOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavSettingsButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource NavButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSettingsOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeButtonBaseStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Background" Value="{StaticResource ControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SpectrumModeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModeButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualizerMode}" Value="{x:Static controls:VisualizerDisplayMode.NeonSpectrum}">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TwinWaveModeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModeButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualizerMode}" Value="{x:Static controls:VisualizerDisplayMode.TwinWave}">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HaloModeButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModeButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding VisualizerMode}" Value="{x:Static controls:VisualizerDisplayMode.HaloCircle}">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentSecondaryBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MascotFloatImageStyle" TargetType="{x:Type Image}">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="MascotFloatStoryboard">
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 From="-2" To="3" Duration="0:0:3.2">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="MascotFloatStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrackTitleTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentTrack}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NowPlayingEqualizerBarStyle" TargetType="{x:Type Rectangle}">
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="8"/>
            <Setter Property="Fill" Value="{StaticResource OnAccentBrush}"/>
            <Setter Property="Margin" Value="0.75,0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,1"/>
        </Style>
        <Style x:Key="NowPlayingEqualizerBar1Style" TargetType="{x:Type Rectangle}"
               BasedOn="{StaticResource NowPlayingEqualizerBarStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrentTrackPlaying}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="NowPlayingEqualizerBar1Storyboard">
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.35" To="1" Duration="0:0:0.42"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="NowPlayingEqualizerBar1Storyboard"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NowPlayingEqualizerBar2Style" TargetType="{x:Type Rectangle}"
               BasedOn="{StaticResource NowPlayingEqualizerBarStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrentTrackPlaying}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="NowPlayingEqualizerBar2Storyboard">
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.95" To="0.3" Duration="0:0:0.53"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="NowPlayingEqualizerBar2Storyboard"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NowPlayingEqualizerBar3Style" TargetType="{x:Type Rectangle}"
               BasedOn="{StaticResource NowPlayingEqualizerBarStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrentTrackPlaying}" Value="True"/>
                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="NowPlayingEqualizerBar3Storyboard">
                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.5" To="1" Duration="0:0:0.61"
                                                 BeginTime="0:0:0.08"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="NowPlayingEqualizerBar3Storyboard"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ColumnHeaderButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlaylistView}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ColumnHeaderButtonRightStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ColumnHeaderButtonStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo Description="{Binding TaskbarDescription}"
                         ProgressState="{Binding TaskbarProgressState}"
                         ProgressValue="{Binding TaskbarProgressValue}">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfoCollection>
                    <ThumbButtonInfo Description="{Binding Loc[Common_Previous]}"
                                     ImageSource="{StaticResource TaskbarPreviousImage}"
                                     Command="{Binding PreviousCommand}"
                                     DismissWhenClicked="False"/>
                    <ThumbButtonInfo Description="{Binding Loc[Common_Play]}"
                                     ImageSource="{StaticResource TaskbarPlayImage}"
                                     Command="{Binding PlayPauseCommand}"
                                     Visibility="{Binding TaskbarPlayButtonVisibility}"
                                     DismissWhenClicked="False"/>
                    <ThumbButtonInfo Description="{Binding Loc[Common_Pause]}"
                                     ImageSource="{StaticResource TaskbarPauseImage}"
                                     Command="{Binding PlayPauseCommand}"
                                     Visibility="{Binding TaskbarPauseButtonVisibility}"
                                     DismissWhenClicked="False"/>
                    <ThumbButtonInfo Description="{Binding Loc[Common_Next]}"
                                     ImageSource="{StaticResource TaskbarNextImage}"
                                     Command="{Binding NextCommand}"
                                     DismissWhenClicked="False"/>
                </ThumbButtonInfoCollection>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Grid x:Name="ShellGrid" Margin="18"
          behaviors:FileDropBehavior.Command="{Binding AddDroppedPathsCommand}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="AppHeaderRow" Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="AppTransportRow" Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel x:Name="AppHeader" Grid.Row="0" Margin="6,0,6,14">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Image Width="38" Height="38"
                       Source="pack://application:,,,/Assets/mimi-256.png"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="MIMI" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Loc[App_MusicUniverse]}" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>
            <!-- One brand line is enough up here; the tagline moved to the
                 rail footer so the header stays a single quiet row. -->
            <TextBlock Text="{Binding Loc[App_Tagline]}" Foreground="{StaticResource TextFaintBrush}"
                       FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="210" MinWidth="180"/>
                <ColumnDefinition x:Name="MainColumn" Width="*" MinWidth="420"/>
                <ColumnDefinition x:Name="NowPlayingColumn" Width="270" MinWidth="250"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="NavRail" Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="12" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Loc[Nav_YourSpace]}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="10" FontWeight="SemiBold" Margin="9,6,0,10"/>
                        <Button Command="{Binding ShowHomeCommand}" Style="{StaticResource NavButtonStyle}"
                                AutomationProperties.Name="{Binding Loc[Nav_Home]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource HomeIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="{Binding Loc[Nav_Home]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowLibraryCommand}" Style="{StaticResource NavLibraryButtonStyle}"
                                AutomationProperties.Name="{Binding Loc[Nav_MyLibrary]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource MusicIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="{Binding Loc[Nav_MyLibrary]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleFavoritesViewCommand}" Style="{StaticResource NavFavoritesButtonStyle}"
                                AutomationProperties.Name="{Binding Loc[Nav_Favorites]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource HeartIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="{Binding Loc[Nav_Favorites]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowRecentCommand}" Style="{StaticResource NavRecentButtonStyle}"
                                AutomationProperties.Name="{Binding Loc[Nav_RecentlyPlayed]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource HistoryIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="{Binding Loc[Nav_RecentlyPlayed]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource NavSectionRuleStyle}"/>
                        <Button Command="{Binding ShowRadioCommand}" Style="{StaticResource NavRadioButtonStyle}"
                                Visibility="{Binding IsRadioAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding Loc[Nav_Radio]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource RadioIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="{Binding Loc[Nav_Radio]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowOnlineCommand}" Style="{StaticResource NavOnlineButtonStyle}"
                                Visibility="{Binding IsOnlineAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding Loc[Nav_Online]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource OnlineMusicIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="{Binding Loc[Nav_Online]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowYouTubeCommand}" Style="{StaticResource NavYouTubeButtonStyle}"
                                Visibility="{Binding IsYouTubeAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding Loc[Nav_YouTube]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource YouTubeIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="{Binding Loc[Nav_YouTube]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource NavSectionRuleStyle}"/>
                        <Button Command="{Binding AddFilesCommand}" Style="{StaticResource NavButtonStyle}"
                                AutomationProperties.Name="{Binding Loc[Nav_AddMusicFiles]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PlusIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="{Binding Loc[Nav_AddMusicFiles]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding AddFolderCommand}" Style="{StaticResource NavButtonStyle}"
                                AutomationProperties.Name="{Binding Loc[Nav_ScanFolder]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FolderIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                <TextBlock Text="{Binding Loc[Nav_ScanFolder]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <DockPanel Margin="8,26,2,8" LastChildFill="False">
                            <TextBlock Text="{Binding Loc[Nav_Playlists]}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                            <Button Command="{Binding CreatePlaylistCommand}" DockPanel.Dock="Right"
                                    Padding="8,3" Margin="8,0,0,0" ToolTip="{Binding Loc[Playlist_New]}"
                                    AutomationProperties.Name="{Binding Loc[Playlist_New]}">
                                <Path Data="{StaticResource PlusIconGeometry}"
                                      Style="{StaticResource IconPathStyle}"/>
                            </Button>
                        </DockPanel>
                        <UniformGrid Columns="3" Margin="2,0,2,4"
                                     IsEnabled="{Binding HasSelectedPlaylist}">
                            <Button Command="{Binding PlaySelectedPlaylistCommand}"
                                    Padding="6,6" ToolTip="{Binding Loc[Playlist_PlaySelected]}"
                                    AutomationProperties.Name="{Binding Loc[Playlist_PlaySelected]}">
                                <Path Data="{StaticResource PlayIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                            </Button>
                            <Button Command="{Binding RenameSelectedPlaylistCommand}"
                                    Padding="6,6" ToolTip="{Binding Loc[Playlist_RenameSelected]}"
                                    AutomationProperties.Name="{Binding Loc[Playlist_RenameSelected]}">
                                <Path Data="{StaticResource EditIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                            </Button>
                            <Button Command="{Binding DeleteSelectedPlaylistCommand}"
                                    Padding="6,6" ToolTip="{Binding Loc[Playlist_DeleteSelected]}"
                                    AutomationProperties.Name="{Binding Loc[Playlist_DeleteSelected]}">
                                <Path Data="{StaticResource DeleteIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource RaisedBackgroundBrush}"
                            CornerRadius="12" Padding="10,8" Margin="1,10,1,1">
                        <StackPanel>
                            <TextBlock Text="MIMI BETA" Foreground="{StaticResource AccentBrush}"
                                       FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Loc[Nav_BetaDescription]}" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Bottom" Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource NavSettingsButtonStyle}" Margin="1,4,1,0"
                            HorizontalContentAlignment="Left"
                            AutomationProperties.Name="{Binding Loc[Nav_Settings]}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SettingsIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                            <TextBlock Text="{Binding Loc[Nav_Settings]}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Grid Margin="2,4,2,8">
                        <ListBox ItemsSource="{Binding Playlists}"
                                 SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextStrongBrush}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="{Binding Loc[Playlist_List]}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid MinWidth="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource PlaylistIconGeometry}"
                                                  Style="{StaticResource IconPathStyle}"
                                                  Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="8,0,0,0" MinWidth="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CountLabel}" FontSize="10"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Button Grid.Column="1" Padding="7,4" Margin="6,0,0,0"
                                                Command="{Binding DataContext.PlayPlaylistCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding DataContext.Loc[Playlist_Play], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                AutomationProperties.Name="{Binding DataContext.Loc[Playlist_Play], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                                            <Path Data="{StaticResource PlayIconGeometry}"
                                                  Style="{StaticResource IconPathStyle}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MimiRowItemStyle}">
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="Margin" Value="1"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="{Binding Loc[Playlist_Empty]}"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="10,8" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Playlists.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <Grid x:Name="MainContent" Grid.Column="1" Margin="0,0,14,0"
                  Visibility="{Binding IsLibraryContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="{StaticResource HeroCornerRadius}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" Margin="0,0,0,16" ClipToBounds="True"
                        Background="{StaticResource HeroGradientBrush}">
                    <Grid>
                        <Border CornerRadius="{StaticResource HeroCornerRadius}"
                                Background="{StaticResource HeroSecondaryGlowBrush}"
                                Opacity="0.62" IsHitTestVisible="False"/>
                        <Border CornerRadius="{StaticResource HeroCornerRadius}"
                                Background="{StaticResource HeroAccentGlowBrush}"
                                Opacity="0.82" IsHitTestVisible="False">
                            <Border.Effect>
                                <effects:AuroraGlowEffect AccentColor="{DynamicResource AccentColor}"
                                                          SecondaryColor="{DynamicResource AccentSecondaryColor}"
                                                          Strength="0.42" Phase="0.18"/>
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="{StaticResource HeroCornerRadius}"
                                Background="{StaticResource HeroTopHighlightBrush}"
                                Opacity="0.5" IsHitTestVisible="False"/>
                        <DockPanel Margin="24">
                        <Grid DockPanel.Dock="Right" Width="132" Height="162" Margin="16,0,0,0"
                              VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Width="118" Height="118" Fill="{StaticResource AccentDecorMediumBrush}"
                                     Opacity="0.36" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="24"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Image Source="pack://application:,,,/Assets/Mascot/mimi-mascot-v1.png"
                                   Stretch="Uniform" Style="{StaticResource MascotFloatImageStyle}"
                                   AutomationProperties.Name="{Binding Loc[Mascot_Automation]}">
                                <Image.RenderTransform>
                                    <TranslateTransform/>
                                </Image.RenderTransform>
                                <Image.Effect>
                                    <DropShadowEffect Color="{DynamicResource AppBackgroundColor}" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.42"/>
                                </Image.Effect>
                            </Image>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Loc[Home_Welcome]}" Foreground="{StaticResource AccentBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding Loc[Home_HeroTitle]}" FontSize="30" FontWeight="Bold" Margin="0,12,0,8"/>
                            <TextBlock Text="{Binding Loc[Home_HeroDescription]}"
                                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,14"/>
                            <Button Command="{Binding AddFilesCommand}" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                                    FontWeight="Bold" AutomationProperties.Name="{Binding Loc[Home_AddFirstSongs]}">
                                <Button.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="18" ShadowDepth="0" Opacity="0.36"/>
                                </Button.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource PlusIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                    <TextBlock Text="{Binding Loc[Home_AddFirstSongs]}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </DockPanel>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Margin="2,0,2,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding SectionTitle}" FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TrackCountLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                        <StackPanel Margin="0,8,16,0" Width="330"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="{Binding ScanStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                <Button Content="{Binding Loc[Common_Cancel]}" Command="{Binding CancelScanCommand}" DockPanel.Dock="Right"
                                        Padding="8,3" Margin="8,0,0,0" FontSize="11"
                                        AutomationProperties.Name="{Binding Loc[Library_CancelScanAutomation]}"/>
                            </DockPanel>
                            <ProgressBar Minimum="0" Maximum="100" Height="5" Margin="0,6,0,0"
                                         Value="{Binding ScanProgressPercent, Mode=OneWay}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SearchStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" MinHeight="15" Margin="0,5,16,0"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <WrapPanel Margin="0,4,12,0"
                                   Visibility="{Binding IsPlaylistView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="{Binding Loc[Library_UpButton]}" Command="{Binding MoveSelectedPlaylistTrackUpCommand}"
                                    IsEnabled="{Binding IsPlaylistReorderEnabled}"
                                    Padding="8,4" Margin="0,0,4,4" FontSize="11"
                                    AutomationProperties.Name="{Binding Loc[Library_MoveSelectedSongUp]}"/>
                            <Button Content="{Binding Loc[Library_DownButton]}" Command="{Binding MoveSelectedPlaylistTrackDownCommand}"
                                    IsEnabled="{Binding IsPlaylistReorderEnabled}"
                                    Padding="8,4" Margin="0,0,4,4" FontSize="11"
                                    AutomationProperties.Name="{Binding Loc[Library_MoveSelectedSongDown]}"/>
                            <Button Content="{Binding Loc[Playlist_RemoveFromPlaylist]}"
                                    Command="{Binding RemoveSelectedTrackFromPlaylistCommand}"
                                    Padding="8,4" Margin="0,0,4,4" FontSize="11"
                                    AutomationProperties.Name="{Binding Loc[Playlist_RemoveSelectedSong]}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding Loc[Playlist_DragRearrange]}"
                                   Foreground="{StaticResource TextFaintBrush}" FontSize="10"
                                   Visibility="{Binding IsPlaylistReorderEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                    <Border Width="190" MinWidth="140" Height="34" VerticalAlignment="Top"
                            Background="{StaticResource RaisedBackgroundBrush}" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SearchIconGeometry}" Width="16" Height="16" Stretch="Uniform"
                                  Fill="{StaticResource TextMutedBrush}" Margin="10,0,6,0" VerticalAlignment="Center"
                                  IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchTextBox" Grid.Column="1"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center"
                                     Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Padding="0,0,10,0"
                                     ToolTip="{Binding Loc[Library_SearchSongs]}" AutomationProperties.Name="{Binding Loc[Library_SearchSongs]}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Loc[Library_SearchPlaceholder]}"
                                       Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DockPanel>

                <!-- Five always-open comboboxes pushed the toolbar onto two
                     rows and never showed which filters were on. The filters
                     now sit behind one button, and anything active stays
                     visible as a chip that can be removed without opening the
                     panel. -->
                <StackPanel Grid.Row="2" Margin="2,0,2,10">
                    <WrapPanel VerticalAlignment="Center">
                        <Button Command="{Binding ToggleFilterPanelCommand}"
                                Padding="10,5" Margin="0,0,8,4" FontSize="11"
                                ToolTip="{Binding Loc[Library_Filters]}"
                                AutomationProperties.Name="{Binding Loc[Library_Filters]}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource FilterIconGeometry}" Width="13" Height="13"
                                      Stretch="Uniform" VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                                <TextBlock Text="{Binding Loc[Library_Filters]}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="6" Padding="5,0"
                                        Margin="6,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasActiveLibraryFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ActiveLibraryFilterCount}" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource OnAccentBrush}"/>
                                </Border>
                                <Path Data="{StaticResource ChevronDownIconGeometry}" Width="10" Height="10"
                                      Stretch="Uniform" Margin="6,1,0,0" VerticalAlignment="Center"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}">
                                    <Path.Style>
                                        <Style TargetType="{x:Type Path}">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform CenterX="5" CenterY="5" Angle="0"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFilterPanelOpen}" Value="True">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform CenterX="5" CenterY="5" Angle="180"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding ActiveLibraryFilters}" Margin="0,0,4,4"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SelectedBackgroundBrush}"
                                            BorderBrush="{StaticResource SelectedBorderBrush}" BorderThickness="1"
                                            CornerRadius="9" Padding="9,2,3,2" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Text}" FontSize="11"
                                                       Foreground="{StaticResource TextStrongBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="✕" Padding="4,0" Margin="5,0,0,0" FontSize="9"
                                                    Background="Transparent" BorderThickness="0"
                                                    Command="{Binding DataContext.ClearLibraryFilterCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                    CommandParameter="{Binding Kind}"
                                                    ToolTip="{Binding Text}"
                                                    AutomationProperties.Name="{Binding Text}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SelectedTracksCountLabel}" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11" VerticalAlignment="Center" Margin="2,0,6,4"
                                   Visibility="{Binding HasSelectedTracks, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="{Binding Loc[Library_PlayNext]}"
                                Command="{Binding PlayNextSelectedCommand}"
                                Padding="9,5" Margin="0,0,6,4" FontSize="11"
                                Visibility="{Binding HasSelectedTracks, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding Loc[Library_PlaySelectedSongsNext]}"/>
                        <Button Content="{Binding Loc[Library_AddToQueue]}"
                                Command="{Binding AddSelectedToQueueCommand}"
                                Padding="9,5" Margin="0,0,6,4" FontSize="11"
                                Visibility="{Binding HasSelectedTracks, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding Loc[Library_AddSelectedSongsToQueue]}"/>
                        <Button Content="{Binding Loc[Library_FavoriteSelected]}"
                                Command="{Binding ToggleSelectedFavoritesCommand}"
                                Padding="9,5" Margin="0,0,6,4" FontSize="11"
                                Visibility="{Binding HasMultipleSelectedTracks, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding Loc[Library_ToggleFavoritesSelected]}"/>
                        <Button Content="{Binding Loc[Common_RemoveSelected]}"
                                Command="{Binding RemoveSelectedTrackCommand}"
                                Padding="9,5" Margin="0,0,0,4" FontSize="11"
                                Visibility="{Binding HasMultipleSelectedTracks, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.Name="{Binding Loc[Library_RemoveSelectedSongs]}"/>
                    </WrapPanel>

                    <Border Background="{StaticResource RaisedBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="12,10,12,6" Margin="0,2,0,0"
                            Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <WrapPanel>
                                <StackPanel Width="196" Margin="0,0,10,6">
                                    <TextBlock Text="{Binding Loc[Library_FilterByArtist]}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding ArtistFilterOptions}"
                                              SelectedItem="{Binding SelectedArtistFilter, Mode=TwoWay}"
                                              Height="30" Padding="6,2"
                                              Background="{StaticResource SunkenBackgroundBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                              AutomationProperties.Name="{Binding Loc[Library_FilterByArtist]}"/>
                                </StackPanel>
                                <StackPanel Width="196" Margin="0,0,10,6">
                                    <TextBlock Text="{Binding Loc[Library_FilterByAlbum]}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AlbumFilterOptions}"
                                              SelectedItem="{Binding SelectedAlbumFilter, Mode=TwoWay}"
                                              Height="30" Padding="6,2"
                                              Background="{StaticResource SunkenBackgroundBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                              AutomationProperties.Name="{Binding Loc[Library_FilterByAlbum]}"/>
                                </StackPanel>
                                <StackPanel Width="196" Margin="0,0,10,6">
                                    <TextBlock Text="{Binding Loc[Library_FilterByGenre]}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding GenreFilterOptions}"
                                              SelectedItem="{Binding SelectedGenreFilter, Mode=TwoWay}"
                                              Height="30" Padding="6,2"
                                              Background="{StaticResource SunkenBackgroundBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                              AutomationProperties.Name="{Binding Loc[Library_FilterByGenre]}"/>
                                </StackPanel>
                                <StackPanel Width="196" Margin="0,0,10,6">
                                    <TextBlock Text="{Binding Loc[Library_FilterByFormat]}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding FormatFilterOptions}"
                                              SelectedItem="{Binding SelectedFormatFilter, Mode=TwoWay}"
                                              Height="30" Padding="6,2"
                                              Background="{StaticResource SunkenBackgroundBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                              AutomationProperties.Name="{Binding Loc[Library_FilterByFormat]}"/>
                                </StackPanel>
                                <StackPanel Width="196" Margin="0,0,10,6">
                                    <TextBlock Text="{Binding Loc[Library_FilterByPlaybackState]}"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding PlaybackStateFilterOptions}"
                                              SelectedItem="{Binding SelectedPlaybackStateFilter, Mode=TwoWay}"
                                              Height="30" Padding="6,2"
                                              Background="{StaticResource SunkenBackgroundBrush}"
                                              Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0"
                                              AutomationProperties.Name="{Binding Loc[Library_FilterByPlaybackState]}"/>
                                </StackPanel>
                            </WrapPanel>
                            <Button Content="{Binding Loc[Common_Clear]}"
                                    Command="{Binding ClearLibraryFiltersCommand}"
                                    HorizontalAlignment="Right" Padding="9,4" FontSize="11"
                                    AutomationProperties.Name="{Binding Loc[Library_ClearFiltersAutomation]}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="3" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8">
                    <Grid>
                    <ListView x:Name="TrackList" ItemsSource="{Binding TracksView}"
                              SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                              SelectionMode="Extended"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextStrongBrush}" AutomationProperties.Name="{Binding Loc[Library_TrackList]}"
                              behaviors:SelectedItemsBehavior.SelectedItems="{Binding SelectedTracks}"
                              behaviors:ItemClickCommandBehavior.Command="{Binding PlayTrackCommand}"
                              behaviors:PlaylistReorderBehavior.MoveCommand="{Binding MovePlaylistTrackCommand}"
                              behaviors:PlaylistReorderBehavior.IsReorderEnabled="{Binding IsPlaylistReorderEnabled}">
                        <ListView.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding RemoveSelectedTrackCommand}"/>
                            <KeyBinding Key="Return" Command="{Binding PlayTrackCommand}"
                                        CommandParameter="{Binding SelectedTrack}"/>
                        </ListView.InputBindings>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[Common_Play], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Command="{Binding PlacementTarget.DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.SelectedTrack, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[Library_PlaySelectedNext], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
