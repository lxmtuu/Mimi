                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Path Data="{StaticResource PauseIconGeometry}">
                                                <Path.Style>
                                                    <Style TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18"
                    Padding="20" Margin="0,0,14,0"
                    Visibility="{Binding IsOnlineContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" MaxWidth="520">
                            <TextBlock Text="{Binding Loc[Online_Title]}" FontSize="23" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Loc[Online_Description]}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border DockPanel.Dock="Right" Background="{StaticResource RaisedBackgroundBrush}"
                                CornerRadius="10" Padding="10,7" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Loc[Online_Source]}"
                                       Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Loc[Online_SearchLabel]}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="2,0,0,5"/>
                            <TextBox Text="{Binding OnlineSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding Loc[Online_SearchAutomation]}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchOnlineCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding Loc[Online_Search]}"
                                Command="{Binding SearchOnlineCommand}" Padding="14,8" Margin="0,21,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding Loc[Online_SearchAutomation]}"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,10">
                        <TextBlock Text="{Binding OnlineStatusLabel}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" TextWrapping="Wrap"/>
                        <ProgressBar Height="3" Margin="0,7,0,0" IsIndeterminate="True"
                                     Visibility="{Binding IsOnlineLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding OnlineTracks}"
                             behaviors:ItemClickCommandBehavior.Command="{Binding PlayOnlineTrackCommand}"
                             SelectedItem="{Binding SelectedOnlineTrack, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextStrongBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             AutomationProperties.Name="{Binding Loc[Online_ResultListAutomation]}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[Common_Play], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Command="{Binding PlacementTarget.DataContext.PlayOnlineTrackCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.SelectedOnlineTrack, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[Online_OpenSource], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Command="{Binding PlacementTarget.DataContext.OpenOnlineTrackPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.SelectedOnlineTrack, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MimiRowItemStyle}">
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="2"/>
                                <Style.Triggers>
                                    <!-- The row that is actually playing keeps the
                                         selection plate even when another row is
                                         highlighted. -->
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12"
                                            Background="{StaticResource RaisedBackgroundBrush}" VerticalAlignment="Center"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="17" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding ArtworkUrl}" Stretch="UniformToFill"
                                                   Visibility="{Binding HasArtwork, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" MinWidth="0" VerticalAlignment="Center">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{StaticResource AccentBrush}" CornerRadius="7"
                                                    Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding DataContext.Loc[Online_NowPlaying], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                           Foreground="{StaticResource OnAccentBrush}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding MetadataLabel}" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0"
                                                    Visibility="{Binding HasLicense, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding DataContext.Loc[Online_LicensePrefix], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"/>
                                            <TextBlock Text="{Binding LicenseLabel}" Margin="4,0,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DataContext.Loc[Online_Connecting], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="10" Margin="0,3,0,0"
                                                   Visibility="{Binding IsConnecting, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Padding="9,6" Margin="0,0,8,0" VerticalAlignment="Center"
                                            Content="{Binding DataContext.Loc[Online_OpenSource], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            Command="{Binding DataContext.OpenOnlineTrackPageCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding DataContext.Loc[Online_OpenSource], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                                    <Button Grid.Column="3" Padding="10,8" VerticalAlignment="Center"
                                            Command="{Binding DataContext.PlayOnlineTrackCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DataContext.Loc[Online_PlayAutomation], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            AutomationProperties.Name="{Binding DataContext.Loc[Online_PlayAutomation], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                                        <Grid Width="18" Height="18">
                                            <Path Data="{StaticResource PlayIconGeometry}">
                                                <Path.Style>
                                                    <Style TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <Path Data="{StaticResource PauseIconGeometry}">
                                                <Path.Style>
                                                    <Style TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18"
                    Padding="20" Margin="0,0,14,0"
                    Visibility="{Binding IsYouTubeContentVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" MaxWidth="460">
                            <TextBlock Text="{Binding Loc[YouTube_Title]}" FontSize="23" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Loc[YouTube_Description]}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                                       Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- One docked panel instead of three docked buttons: when
                             the window is narrow the description wraps, rather than
                             a button being squeezed until its label is cut off. -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    VerticalAlignment="Top" Margin="12,0,0,0">
                            <Button Content="{Binding YouTubeListToggleLabel}"
                                    Command="{Binding ToggleYouTubeSavedViewCommand}"
                                    Padding="12,7" FontSize="11" Margin="0,0,8,0"
                                    ToolTip="{Binding YouTubeListToggleLabel}"
                                    AutomationProperties.Name="{Binding YouTubeListToggleLabel}"/>
                            <!-- The results are the play order, so this starts the list
                                 the way a playlist would. -->
                            <Button Content="{Binding Loc[YouTube_PlayAll]}"
                                    Command="{Binding PlayAllYouTubeVideosCommand}"
                                    Padding="12,7" FontSize="11" Margin="0,0,8,0"
                                    AutomationProperties.Name="{Binding Loc[YouTube_PlayAll]}"/>
                            <Border Background="{StaticResource RaisedBackgroundBrush}"
                                    CornerRadius="10" Padding="10,7">
                                <TextBlock Text="{Binding Loc[YouTube_ProviderAttribution]}"
                                           Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Loc[YouTube_SearchLabel]}"
                                       Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="2,0,0,5"/>
                            <TextBox Text="{Binding YouTubeSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding Loc[YouTube_SearchAutomation]}">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchYouTubeCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding Loc[YouTube_Search]}"
                                Command="{Binding SearchYouTubeCommand}" Padding="14,8" Margin="0,21,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="{Binding Loc[YouTube_SearchAutomation]}"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,10">
                        <DockPanel>
                            <!-- Beta troubleshooting aid: one click prints what the
                                 player page actually reports. -->
                            <Button DockPanel.Dock="Right" Padding="8,3" FontSize="10" Margin="8,0,0,0"
                                    Content="{Binding Loc[YouTube_Diagnose]}"
                                    Command="{Binding DiagnoseYouTubePlayerCommand}"
                                    Visibility="{Binding IsYouTubePlaying, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.Name="{Binding Loc[YouTube_Diagnose]}"/>
                            <TextBlock Text="{Binding YouTubeStatusLabel}" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ProgressBar Height="3" Margin="0,7,0,0" IsIndeterminate="True"
                                     Visibility="{Binding IsYouTubeLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding YouTubeDisplayedVideos}"
                             SelectedItem="{Binding SelectedYouTubeVideo, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextStrongBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             behaviors:ItemClickCommandBehavior.Command="{Binding PlayYouTubeVideoCommand}"
                             AutomationProperties.Name="{Binding Loc[YouTube_ResultListAutomation]}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[YouTube_Play], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Command="{Binding PlacementTarget.DataContext.PlayYouTubeVideoCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.SelectedYouTubeVideo, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[YouTube_Stop], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Command="{Binding PlacementTarget.DataContext.StopYouTubeVideoCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          IsEnabled="{Binding PlacementTarget.DataContext.IsYouTubePlaying, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[YouTube_PlayAll], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Command="{Binding PlacementTarget.DataContext.PlayAllYouTubeVideosCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                <Separator/>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.SelectedYouTubeFavoriteMenuLabel, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Command="{Binding PlacementTarget.DataContext.ToggleYouTubeFavoriteCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.SelectedYouTubeVideo, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                <Separator/>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[YouTube_CopyLink], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Command="{Binding PlacementTarget.DataContext.CopyYouTubeLinkCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext.SelectedYouTubeVideo, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[YouTube_OpenSource], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Command="{Binding PlacementTarget.DataContext.OpenCurrentYouTubeVideoCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MimiRowItemStyle}">
                                <Setter Property="Padding" Value="8"/>
                                <Setter Property="Margin" Value="2"/>
                                <Style.Triggers>
                                    <!-- The row that is actually playing keeps the
                                         selection plate even when another row is
                                         highlighted. -->
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="56" Height="38" CornerRadius="8"
                                            Background="{StaticResource RaisedBackgroundBrush}" VerticalAlignment="Center"
                                            ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="{Binding Initial}" FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"
                                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,10,0" MinWidth="0" VerticalAlignment="Center">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{StaticResource AccentBrush}" CornerRadius="7"
                                                    Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="{Binding DataContext.Loc[YouTube_NowPlaying], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                           Foreground="{StaticResource OnAccentBrush}" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                            <TextBlock Text="★" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{StaticResource AccentSecondaryBrush}"
                                                       ToolTip="{Binding DataContext.Loc[YouTube_SavedMarker], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                       Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding ChannelTitle}" Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <!-- The visible label is a verb; the automation name keeps the
                                         full sentence, because a screen reader needs the context. -->
                                    <Button Grid.Column="2" Padding="9,6" VerticalAlignment="Center"
                                            Command="{Binding DataContext.PlayYouTubeVideoCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding DataContext.Loc[YouTube_PlayAutomation], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Content"
                                                        Value="{Binding DataContext.Loc[YouTube_Play], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Content"
                                                                Value="{Binding DataContext.Loc[YouTube_StopRow], RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18"
                    Padding="20" Margin="0,0,14,0"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="{Binding Loc[Settings_Title]}" FontSize="23" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[Settings_AutoSaveNote]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Command="{Binding CloseSettingsCommand}" DockPanel.Dock="Right"
                                    Content="✕" Padding="10,7" FontSize="14"
                                    AutomationProperties.Name="{Binding Loc[Settings_Close]}"/>
                        </DockPanel>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_AppearanceSection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[Settings_Language]}" Margin="0,14,0,6"/>
                                <ComboBox SelectedValue="{Binding UiLanguage, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          AutomationProperties.Name="{Binding Loc[Settings_Language]}">
                                    <ComboBoxItem Tag="system" Content="{Binding DataContext.Loc[Language_System], RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>
                                    <ComboBoxItem Tag="en-US" Content="English"/>
                                    <ComboBoxItem Tag="vi-VN" Content="Tiếng Việt"/>
                                </ComboBox>
                                <TextBlock Text="{Binding Loc[Settings_LanguageDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Loc[Settings_Theme]}" Margin="0,18,0,6"/>
                                <!-- Each entry carries its own colours, so a
                                     theme can be judged before it is applied. -->
                                <ComboBox ItemsSource="{Binding ThemeOptions}"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding UiTheme, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Loc[Settings_Theme]}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="44" Height="14" CornerRadius="4"
                                                        Background="{Binding Background}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1"/>
                                                <Border Width="14" Height="14" CornerRadius="4" Margin="3,0,0,0"
                                                        Background="{Binding Accent}"/>
                                                <Border Width="14" Height="14" CornerRadius="4" Margin="3,0,0,0"
                                                        Background="{Binding AccentSecondary}"/>
                                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- Palette of the theme in use: surfaces first,
                                     then accents, so switching is less blind. -->
                                <ItemsControl ItemsSource="{Binding ThemeSwatches}" Margin="0,10,0,0"
                                              IsHitTestVisible="False"
                                              AutomationProperties.Name="{Binding Loc[Settings_Theme]}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="26" Height="12" CornerRadius="3" Margin="0,0,4,0"
                                                    Background="{Binding Brush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ToolTip="{Binding Token}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Loc[Settings_ThemeDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{Binding Loc[Settings_DuplicateTheme]}" Command="{Binding DuplicateThemeForEditingCommand}"
                                            Padding="10,7" FontSize="11"
                                            ToolTip="{Binding Loc[Settings_DuplicateThemeAutomation]}"
                                            AutomationProperties.Name="{Binding Loc[Settings_DuplicateThemeAutomation]}"/>
                                    <Button Content="{Binding Loc[Settings_OpenThemesFolder]}" Command="{Binding OpenThemesFolderCommand}"
                                            Padding="10,7" FontSize="11" Margin="8,0,0,0"
                                            AutomationProperties.Name="{Binding Loc[Settings_OpenThemesFolder]}"/>
                                    <Button Content="{Binding Loc[Settings_ReloadThemes]}" Command="{Binding ReloadThemesCommand}"
                                            Padding="10,7" FontSize="11" Margin="8,0,0,0"
                                            AutomationProperties.Name="{Binding Loc[Settings_ReloadThemes]}"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding Loc[Settings_DuplicateThemeHint]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Loc[Settings_CommunityThemesHint]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <!-- Background colour: one hue for the whole background
                                     family - the layer stack plus the hero, the video
                                     stage and the cover - on top of whichever theme is
                                     selected. Depth stays the theme's own, so this
                                     cannot break the contrast the theme was checked for. -->
                                <TextBlock Text="{Binding Loc[Settings_CustomBackground]}" Margin="0,18,0,6"/>
                                <CheckBox Content="{Binding Loc[Settings_CustomBackgroundToggle]}"
                                          IsChecked="{Binding IsCustomBackgroundEnabled, Mode=TwoWay}"
                                          Margin="0,0,0,8"
                                          AutomationProperties.Name="{Binding Loc[Settings_CustomBackgroundToggle]}"/>
                                <DockPanel Margin="0,0,0,4"
                                           Visibility="{Binding IsCustomBackgroundEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button DockPanel.Dock="Right" Content="{Binding Loc[Settings_ClearCustomBackground]}"
                                            Command="{Binding ClearCustomBackgroundCommand}"
                                            Padding="10,7" FontSize="11" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding Loc[Settings_ClearCustomBackground]}"/>
                                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="8"
                                            Background="{Binding CustomBackgroundPreview}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBox DockPanel.Dock="Left"
                                             Text="{Binding CustomBackgroundHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Width="96" Height="28" VerticalContentAlignment="Center"
                                             AutomationProperties.Name="{Binding Loc[Settings_CustomBackgroundHex]}"/>
                                    <ItemsControl ItemsSource="{Binding CustomBackgroundOptions}"
                                                  VerticalAlignment="Center" Margin="10,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Width="24" Height="24" Padding="0" Margin="0,0,6,0"
                                                        Background="Transparent"
                                                        ToolTip="{Binding Hex}"
                                                        Command="{Binding DataContext.SelectCustomBackgroundCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                        CommandParameter="{Binding Hex}"
                                                        AutomationProperties.Name="{Binding Hex}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="{x:Type Button}">
                                                            <Grid>
                                                                <Ellipse Fill="{Binding Swatch}"
                                                                         Stroke="{StaticResource BorderBrush}"
                                                                         StrokeThickness="1"/>
                                                                <Ellipse x:Name="Ring" Stroke="{StaticResource TextPrimaryBrush}"
                                                                         StrokeThickness="2" Visibility="Collapsed"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DockPanel>
                                <TextBlock Text="{Binding Loc[Settings_CustomBackgroundHint]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding Loc[Settings_CustomBackgroundInvalid]}"
                                           Foreground="{StaticResource TextFaintBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding HasCustomBackgroundProblem, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_PlaybackSessionSection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <DockPanel Margin="0,14,0,4" LastChildFill="False">
                                    <TextBlock Text="{Binding Loc[Settings_Volume]}" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding EffectiveVolumePercentLabel}" Foreground="{StaticResource TextMutedBrush}"
                                               DockPanel.Dock="Right"/>
                                </DockPanel>
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="{Binding Loc[Settings_VolumeAutomation]}"/>
                                <CheckBox IsChecked="{Binding RestorePlaybackSession, Mode=TwoWay}"
                                          Content="{Binding Loc[Settings_RestorePreviousSession]}"
                                          AutomationProperties.Name="{Binding Loc[Settings_RestorePlaybackSessionAutomation]}"/>
                                <TextBlock Text="{Binding Loc[Settings_RestoreSessionDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,4"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Loc[Settings_CurrentSong]}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding NowPlayingTitle}" FontSize="11" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                    <TextBlock Text=" · " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding CurrentTimeLabel}" FontSize="11"/>
                                    <TextBlock Text=" / " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                    <TextBlock Text="{Binding DurationLabel}" FontSize="11"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_AudioOutput]}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"
                                           Margin="0,12,0,2"/>
                                <TextBlock Text="{Binding AudioOutputLabel}"
                                           ToolTip="{Binding AudioOutputLabel}"
                                           FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Loc[Settings_AudioOutputDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,2"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,14,0,0"
                                Visibility="{Binding IsRadioServiceInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_InternetRadioSection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <CheckBox IsChecked="{Binding InternetRadioEnabled, Mode=TwoWay}"
                                          Content="{Binding Loc[Settings_EnableInternetRadio]}"
                                          AutomationProperties.Name="{Binding Loc[Settings_EnableInternetRadio]}"/>
                                <TextBlock Text="{Binding Loc[Settings_InternetRadioDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,4"/>
                                <TextBlock Text="{Binding Loc[Radio_ProviderAttribution]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,2"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,14,0,0"
                                Visibility="{Binding IsOnlineCatalogInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_OnlineSection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <CheckBox IsChecked="{Binding OnlineCatalogEnabled, Mode=TwoWay}"
                                          Content="{Binding Loc[Settings_EnableOnline]}"
                                          AutomationProperties.Name="{Binding Loc[Settings_EnableOnline]}"/>
                                <TextBlock Text="{Binding Loc[Settings_OnlineDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,4"/>
                                <TextBlock Text="{Binding Loc[Online_ProviderAttribution]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,2"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,14,0,0"
                                Visibility="{Binding IsYouTubeServiceInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_YouTubeSection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <CheckBox IsChecked="{Binding YouTubeSearchEnabled, Mode=TwoWay}"
                                          Content="{Binding Loc[Settings_EnableYouTube]}"
                                          AutomationProperties.Name="{Binding Loc[Settings_EnableYouTube]}"/>
                                <TextBlock Text="{Binding Loc[Settings_YouTubeDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,4"/>
                                <!-- Where the key comes from, without offering a field: the
                                     owner wants key setup to stay in the terminal. -->
                                <TextBlock Text="{Binding Loc[Settings_YouTubeKeyHint]}"
                                           Foreground="{StaticResource TextFaintBrush}" FontSize="10"
                                           TextWrapping="Wrap" Margin="24,0,0,4"/>
                                <TextBlock Text="{Binding Loc[YouTube_ProviderAttribution]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,2"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_KeyboardShortcutsSection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Space" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Loc[Shortcut_PlayPause]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + ← / →" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Loc[Shortcut_PreviousNextQueue]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="← / →" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Loc[Shortcut_Seek5Seconds]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="↑ / ↓" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Loc[Shortcut_Volume5Percent]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Loc[Shortcut_MediaKeys]}" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Loc[Shortcut_MediaKeysDescription]}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Ctrl + F" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Loc[Shortcut_FocusSearch]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="F11" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Loc[Shortcut_Stage]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Esc" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Loc[Shortcut_CloseStageOrSettings]}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding Loc[Shortcut_StageModesKey]}" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Loc[Shortcut_StageModes]}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding Loc[Shortcut_DeleteKey]}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Loc[Shortcut_DeleteDescription]}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </Grid>
                                <TextBlock Text="{Binding Loc[Shortcut_Note]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_StartupLibrarySection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <CheckBox IsChecked="{Binding RestoreLibraryView, Mode=TwoWay}"
                                          Content="{Binding Loc[Settings_RestoreLibraryView]}"
                                          AutomationProperties.Name="{Binding Loc[Settings_RestoreLibraryView]}"/>
                                <TextBlock Text="{Binding Loc[Settings_RestoreLibraryViewDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,2"/>
                                <CheckBox IsChecked="{Binding RestoreWindowPlacement, Mode=TwoWay}"
                                          Content="{Binding Loc[Settings_RememberWindow]}"
                                          AutomationProperties.Name="{Binding Loc[Settings_RememberWindow]}"/>
                                <TextBlock Text="{Binding Loc[Settings_RememberWindowDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,2"/>
                                <CheckBox IsChecked="{Binding AutoUpgradeLegacyCoverArt, Mode=TwoWay}"
                                          Content="{Binding Loc[Settings_OptimizeCoverCache]}"
                                          AutomationProperties.Name="{Binding Loc[Settings_OptimizeCoverCache]}"/>
                                <TextBlock Text="{Binding Loc[Settings_OptimizeCoverCacheDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,2"/>
                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,4"/>
                                <TextBlock Text="{Binding Loc[Settings_WatchedFoldersSection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="10" FontWeight="Bold" Margin="0,4,0,0"/>
                                <CheckBox IsChecked="{Binding WatchLibraryFolders, Mode=TwoWay}"
                                          Content="{Binding Loc[Settings_WatchFolders]}"
                                          AutomationProperties.Name="{Binding Loc[Settings_WatchFolders]}"/>
                                <TextBlock Text="{Binding Loc[Settings_WatchFoldersDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,8"/>
                                <ListBox ItemsSource="{Binding WatchedFolders}"
                                         SelectedItem="{Binding SelectedWatchedFolder, Mode=TwoWay}"
                                         Height="88" Background="{StaticResource SunkenBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                         Foreground="{StaticResource TextStrongBrush}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AutomationProperties.Name="{Binding Loc[Settings_WatchedFoldersList]}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" ToolTip="{Binding}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MimiRowItemStyle}">
                                            <Setter Property="Padding" Value="6,4"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="{Binding Loc[Settings_AddWatchedFolder]}"
                                            Command="{Binding AddWatchedFolderCommand}"
                                            Padding="10,7" FontSize="11"
                                            AutomationProperties.Name="{Binding Loc[Settings_AddWatchedFolderAutomation]}"/>
                                    <Button Content="{Binding Loc[Common_RemoveSelected]}"
                                            Command="{Binding RemoveWatchedFolderCommand}"
                                            Padding="10,7" FontSize="11"
                                            AutomationProperties.Name="{Binding Loc[Settings_RemoveWatchedFolderAutomation]}"/>
                                </WrapPanel>
                                <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,4"/>
                                <TextBlock Text="{Binding Loc[Settings_WindowsIntegrationSection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="10" FontWeight="Bold" Margin="0,4,0,0"/>
                                <CheckBox IsChecked="{Binding IsOpenWithMimiRegistered, Mode=TwoWay}"
                                          Content="{Binding Loc[Settings_RegisterWindows]}"
                                          AutomationProperties.Name="{Binding Loc[Settings_RegisterWindows]}"/>
                                <TextBlock Text="{Binding Loc[Settings_RegisterWindowsDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,4"/>
                                <TextBlock Text="{Binding OpenWithMimiStatusLabel}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"
                                           Margin="24,0,0,2"/>
                                <TextBlock Text="{Binding OpenWithMimiExecutablePath}"
                                           ToolTip="{Binding OpenWithMimiExecutablePath}"
                                           Foreground="{StaticResource TextDisabledBrush}" FontSize="10"
                                           TextTrimming="CharacterEllipsis" Margin="24,0,0,2"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding Loc[Settings_StageEngineSection]}" Foreground="{StaticResource AccentSecondaryBrush}"
                                               FontSize="11" FontWeight="Bold" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding VisualizerMetricsLabel}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <UniformGrid Columns="3" Margin="0,10,0,0">
                                    <Button Content="{Binding Loc[Stage_ModeSpectrum]}" Command="{Binding SelectSpectrumModeCommand}"
                                            Style="{StaticResource SpectrumModeButtonStyle}"
                                            AutomationProperties.Name="{Binding Loc[Settings_ModeSpectrumAutomation]}"/>
                                    <Button Content="{Binding Loc[Stage_ModeTwinWave]}" Command="{Binding SelectTwinWaveModeCommand}"
                                            Style="{StaticResource TwinWaveModeButtonStyle}"
                                            AutomationProperties.Name="{Binding Loc[Settings_ModeTwinWaveAutomation]}"/>
                                    <Button Content="{Binding Loc[Stage_ModeHalo]}" Command="{Binding SelectHaloModeCommand}"
                                            Style="{StaticResource HaloModeButtonStyle}"
                                            AutomationProperties.Name="{Binding Loc[Settings_ModeHaloAutomation]}"/>
                                </UniformGrid>
                                <TextBlock Text="{Binding Loc[Settings_VisualizerRestored]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="2,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_DataDiagnosticsSection]}" Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <DockPanel Margin="0,12,0,8">
                                    <Border DockPanel.Dock="Left" Width="44" Height="56" Margin="0,0,10,0"
                                            IsHitTestVisible="False">
                                        <Image Source="pack://application:,,,/Assets/Mascot/mimi-mascot-v1.png"
                                               Stretch="Uniform"
                                               AutomationProperties.Name="{Binding Loc[Mascot_Automation]}"/>
                                    </Border>
                                    <TextBlock Text="{Binding AppVersionLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Loc[Settings_DataFolder]}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding DataDirectory}" ToolTip="{Binding DataDirectory}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>
                                <TextBlock Text="{Binding Loc[Settings_LogFolder]}" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock Text="{Binding LogDirectory}" ToolTip="{Binding LogDirectory}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="{Binding Loc[Settings_OpenDataFolder]}" Command="{Binding OpenDataFolderCommand}"
                                            Padding="10,7" FontSize="11"
                                            AutomationProperties.Name="{Binding Loc[Settings_OpenDataFolderAutomation]}"/>
                                    <Button Content="{Binding Loc[Settings_OpenLogs]}" Command="{Binding OpenLogFolderCommand}"
                                            Padding="10,7" FontSize="11"
                                            AutomationProperties.Name="{Binding Loc[Settings_OpenLogsAutomation]}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource MimiCardStyle}" Padding="14" Margin="0,14,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_DefaultsSection]}" Foreground="{StaticResource AccentSecondaryBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[Settings_ResetDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                <Button Content="{Binding Loc[Settings_ResetSettings]}" Command="{Binding ResetSettingsCommand}"
                                        Background="{StaticResource DangerBackgroundBrush}" HorizontalAlignment="Left"
                                        Padding="12,8" FontSize="11"
                                        AutomationProperties.Name="{Binding Loc[Settings_ResetAutomation]}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="NowPlayingPanel" Grid.Column="2" Background="{StaticResource NowPlayingPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[NowPlaying_Title]}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <Border x:Name="PlayerCard" Margin="0,14,0,16" CornerRadius="16" ClipToBounds="True">
                            <!-- YouTube requires an embedded player to be at least
                                 200x200 so its own controls fit. The visualizer card is
                                 210 tall, which leaves the video less than that, so the
                                 card grows while a video plays. -->
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Height" Value="210"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsYouTubePlaying}" Value="True">
                                            <Setter Property="Height" Value="300"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.26"/>
                            </Border.Effect>
                            <Grid Background="{StaticResource CoverGradientBrush}">
                                <!-- Shape-only mask: white is not a visible UI color. It clips every cover layer to the same rounded card shape at any panel width. -->
                                <Grid.OpacityMask>
                                    <DrawingBrush Stretch="Fill" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="White">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,1" RadiusX="0.067" RadiusY="0.076"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.OpacityMask>
                                <Grid Visibility="{Binding IsVisualizerSurfaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Image Source="{Binding CurrentCoverArtPath}" Stretch="UniformToFill"
                                       Opacity="0.55" IsHitTestVisible="False"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                    </Image.RenderTransform>
                                    <Image.Effect>
                                        <BlurEffect Radius="24"/>
                                    </Image.Effect>
                                </Image>
                                <Border CornerRadius="16" Background="{StaticResource NowPlayingGlowBrush}"
                                        Opacity="0.72" IsHitTestVisible="False"/>
                                <Image Source="{Binding CurrentCoverArtPath}" Stretch="UniformToFill"
                                       Opacity="0.46" IsHitTestVisible="False"/>
                                <Border CornerRadius="16" Background="{StaticResource CoverSheenBrush}"
                                        Opacity="0.55" IsHitTestVisible="False"/>
                                <Ellipse Width="150" Height="150" Stroke="{StaticResource AccentDecorMediumBrush}" StrokeThickness="1.5"/>
                                <Ellipse Width="110" Height="110" Stroke="{StaticResource AccentDecorVividBrush}" StrokeThickness="1.5"/>
                                <TextBlock Text="♫" FontSize="62" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <controls:VisualizerView x:Name="MainVisualizer" Mode="{Binding VisualizerMode, Mode=OneWay}"
                                                         PrimaryColor="{DynamicResource AccentColor}"
                                                         SecondaryColor="{DynamicResource AccentSecondaryColor}"
                                                         PeakColor="{DynamicResource AccentHotColor}"
                                                         BaselineColor="{DynamicResource TextMutedColor}"
                                                         Margin="14,10,14,24" IsHitTestVisible="False"/>
                                <TextBlock Text="{Binding Loc[App_MusicInMotion]}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                                </Grid>
                                <!-- The official YouTube player lives in this same card: the
                                     visualizer and the video never share the frame, and the
                                     player is always visible while it plays. -->
                                <Grid Visibility="{Binding IsYouTubePlaying, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Background="{DynamicResource SunkenBackgroundBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="8,5,8,3" LastChildFill="False">
                                        <Button DockPanel.Dock="Right" Padding="7,2" FontSize="10"
                                                Content="{Binding Loc[YouTube_Stop]}"
                                                Command="{Binding StopYouTubeVideoCommand}"
                                                AutomationProperties.Name="{Binding Loc[YouTube_Stop]}"/>
                                        <Button DockPanel.Dock="Right" Padding="7,2" FontSize="10" Margin="0,0,5,0"
                                                Content="{Binding Loc[YouTube_OpenSource]}"
                                                Command="{Binding OpenCurrentYouTubeVideoCommand}"
                                                AutomationProperties.Name="{Binding Loc[YouTube_OpenSource]}"/>
