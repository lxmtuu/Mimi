                                <TextBlock Text="{Binding LogDirectory}" ToolTip="{Binding LogDirectory}"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Content="{Binding Loc[Settings_OpenDataFolder]}" Command="{Binding OpenDataFolderCommand}"
                                            Padding="10,7" FontSize="11"
                                            AutomationProperties.Name="{Binding Loc[Settings_OpenDataFolderAutomation]}"/>
                                    <Button Content="{Binding Loc[Settings_OpenLogs]}" Command="{Binding OpenLogFolderCommand}"
                                            Padding="10,7" FontSize="11"
                                            AutomationProperties.Name="{Binding Loc[Settings_OpenLogsAutomation]}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource RaisedBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0,14,0,6">
                            <StackPanel>
                                <TextBlock Text="{Binding Loc[Settings_DefaultsSection]}" Foreground="{StaticResource AccentSecondaryBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Loc[Settings_ResetDescription]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,8"/>
                                <Button Content="{Binding Loc[Settings_ResetSettings]}" Command="{Binding ResetSettingsCommand}"
                                        Background="{StaticResource DangerBackgroundBrush}" HorizontalAlignment="Left"
                                        Padding="12,8" FontSize="11"
                                        AutomationProperties.Name="{Binding Loc[Settings_ResetAutomation]}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource NowPlayingPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding Loc[NowPlaying_Title]}" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                        <Border Height="210" Margin="0,14,0,16" CornerRadius="16" ClipToBounds="True">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.26"/>
                            </Border.Effect>
                            <Grid Background="{StaticResource CoverGradientBrush}">
                                <!-- Shape-only mask: white is not a visible UI color. It clips every cover layer to the same rounded card shape at any panel width. -->
                                <Grid.OpacityMask>
                                    <DrawingBrush Stretch="Fill" Viewbox="0,0,1,1" ViewboxUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="White">
                                                <GeometryDrawing.Geometry>
                                                    <RectangleGeometry Rect="0,0,1,1" RadiusX="0.067" RadiusY="0.076"/>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Grid.OpacityMask>
                                <Image Source="{Binding CurrentCoverArtPath}" Stretch="UniformToFill"
                                       Opacity="0.55" IsHitTestVisible="False"
                                       RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                    </Image.RenderTransform>
                                    <Image.Effect>
                                        <BlurEffect Radius="24"/>
                                    </Image.Effect>
                                </Image>
                                <Border CornerRadius="16" Background="{StaticResource NowPlayingGlowBrush}"
                                        Opacity="0.72" IsHitTestVisible="False"/>
                                <Image Source="{Binding CurrentCoverArtPath}" Stretch="UniformToFill"
                                       Opacity="0.46" IsHitTestVisible="False"/>
                                <Border CornerRadius="16" Background="{StaticResource CoverSheenBrush}"
                                        Opacity="0.55" IsHitTestVisible="False"/>
                                <Ellipse Width="150" Height="150" Stroke="{StaticResource AccentDecorMediumBrush}" StrokeThickness="1.5"/>
                                <Ellipse Width="110" Height="110" Stroke="{StaticResource AccentDecorVividBrush}" StrokeThickness="1.5"/>
                                <TextBlock Text="♫" FontSize="62" Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <controls:VisualizerView x:Name="MainVisualizer" Mode="{Binding VisualizerMode, Mode=OneWay}"
                                                         PrimaryColor="{DynamicResource AccentColor}"
                                                         SecondaryColor="{DynamicResource AccentSecondaryColor}"
                                                         PeakColor="{DynamicResource AccentHotColor}"
                                                         BaselineColor="{DynamicResource TextMutedColor}"
                                                         Margin="14,10,14,24" IsHitTestVisible="False"/>
                                <TextBlock Text="{Binding Loc[App_MusicInMotion]}" FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="17" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding NowPlayingSubtitle}" Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" Margin="0,5,0,18" TextWrapping="Wrap"/>
                        <Slider x:Name="ProgressSlider" Minimum="0" Maximum="100"
                                Value="{Binding ProgressPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                IsMoveToPointEnabled="True" AutomationProperties.Name="{Binding Loc[NowPlaying_PlaybackPosition]}"/>
                        <DockPanel Margin="0,2,0,16" LastChildFill="False">
                            <TextBlock Text="{Binding CurrentTimeLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding DurationLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="−10s" Command="{Binding SeekBackward10Command}"
                                    Padding="7,8" Margin="2,0" FontSize="11" ToolTip="{Binding Loc[Playback_Back10Seconds]}"
                                    AutomationProperties.Name="{Binding Loc[Playback_Back10Seconds]}"/>
                            <Button Command="{Binding PreviousCommand}" Padding="10,9" Margin="2,0"
                                    AutomationProperties.Name="{Binding Loc[Playback_PreviousTrack]}">
                                <Path Data="{StaticResource PreviousIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                            </Button>
                            <Button Command="{Binding PlayPauseCommand}" Background="{StaticResource AccentBrush}"
                                    Foreground="{StaticResource OnAccentBrush}" Padding="16,9" Margin="2,0"
                                    AutomationProperties.Name="{Binding Loc[Playback_PlayOrPause]}">
                                <Button.Effect>
                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.42"/>
                                </Button.Effect>
                                <Grid Width="20" Height="20">
                                    <Path Data="{StaticResource PlayIconGeometry}">
                                        <Path.Style>
                                            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathStyle}">
                                                <Setter Property="Width" Value="20"/>
                                                <Setter Property="Height" Value="20"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Data="{StaticResource PauseIconGeometry}">
                                        <Path.Style>
                                            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathStyle}">
                                                <Setter Property="Width" Value="20"/>
                                                <Setter Property="Height" Value="20"/>
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                            <Button Command="{Binding NextCommand}" Padding="10,9" Margin="2,0"
                                    AutomationProperties.Name="{Binding Loc[Playback_NextTrack]}">
                                <Path Data="{StaticResource NextIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                            </Button>
                            <Button Content="+10s" Command="{Binding SeekForward10Command}"
                                    Padding="7,8" Margin="2,0" FontSize="11" ToolTip="{Binding Loc[Playback_Forward10Seconds]}"
                                    AutomationProperties.Name="{Binding Loc[Playback_Forward10Seconds]}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Command="{Binding ToggleShuffleCommand}"
                                    Padding="10,6" Margin="4,0"
                                    ToolTip="{Binding ShuffleButtonLabel}"
                                    AutomationProperties.Name="{Binding Loc[Playback_ToggleShuffle]}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsShuffleEnabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="22" Height="24">
                                    <Path Data="{StaticResource ShuffleIconGeometry}" Style="{StaticResource IconPathStyle}"
                                          Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <Ellipse Width="4" Height="4" Fill="{StaticResource AccentBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                             Visibility="{Binding IsShuffleEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                            <Button Command="{Binding CycleRepeatModeCommand}"
                                    Padding="10,6" Margin="4,0"
                                    ToolTip="{Binding RepeatModeLabel}"
                                    AutomationProperties.Name="{Binding Loc[Playback_CycleRepeatMode]}">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRepeatEnabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                <Setter Property="Background" Value="{StaticResource SelectedBackgroundBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Grid Width="22" Height="24">
                                    <Path Data="{StaticResource RepeatIconGeometry}" Style="{StaticResource IconPathStyle}"
                                          Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <TextBlock Text="1" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,0"
                                               Visibility="{Binding IsRepeatOne, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                        <DockPanel Margin="4,20,4,5" LastChildFill="False">
                            <TextBlock Text="{Binding Loc[NowPlaying_VolumeHeader]}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding EffectiveVolumePercentLabel}" Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="10" DockPanel.Dock="Right"/>
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding ToggleMuteCommand}"
                                    Padding="8,5" Margin="0,0,8,0" ToolTip="{Binding MuteButtonLabel}"
                                    AutomationProperties.Name="{Binding Loc[Playback_MuteOrUnmute]}">
                                <Grid Width="18" Height="18">
                                    <Path Data="{StaticResource SpeakerIconGeometry}">
                                        <Path.Style>
                                            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <Path Data="{StaticResource SpeakerMutedIconGeometry}">
                                        <Path.Style>
                                            <Style TargetType="{x:Type Path}" BasedOn="{StaticResource IconPathStyle}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                            <Slider Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                    Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="{Binding Loc[Settings_Volume]}"/>
                        </Grid>
                        <TextBlock Text="{Binding AudioOutputLabel}"
                                   ToolTip="{Binding AudioOutputLabel}"
                                   Foreground="{StaticResource TextDisabledBrush}" FontSize="9"
                                   TextTrimming="CharacterEllipsis" Margin="4,8,4,0"/>
                        <Border Background="{StaticResource WarningBackgroundBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="10" Margin="0,10,0,0"
                                Visibility="{Binding HasAudioOutputNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding AudioOutputNotice}" Foreground="{StaticResource WarningTextBrush}"
                                       FontSize="10" TextWrapping="Wrap"/>
                        </Border>
                        <Border Background="{StaticResource RaisedBackgroundBrush}" CornerRadius="10" Padding="10" Margin="0,18,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding Loc[NowPlaying_UpNext]}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="10" FontWeight="Bold" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding QueueCountLabel}" Foreground="{StaticResource TextMutedBrush}"
                                               FontSize="10" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding QueueStatusLabel}" Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,5,0,8"/>
                                <Grid>
                                <ListView ItemsSource="{Binding UpcomingQueueItems}"
                                          SelectedItem="{Binding SelectedQueueItem, Mode=TwoWay}"
                                          Height="190" Background="{StaticResource SunkenBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                                          BorderThickness="1" Foreground="{StaticResource TextStrongBrush}"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.Name="{Binding Loc[Queue_ListAutomation]}"
                                          behaviors:ItemClickCommandBehavior.Command="{Binding PlayQueueItemCommand}"
                                          behaviors:PlaylistReorderBehavior.MoveCommand="{Binding MoveQueueItemCommand}"
                                          behaviors:PlaylistReorderBehavior.IsReorderEnabled="True">
                                    <ListView.InputBindings>
                                        <KeyBinding Key="Return"
                                                    Command="{Binding PlayQueueItemCommand}"
                                                    CommandParameter="{Binding SelectedQueueItem}"/>
                                    </ListView.InputBindings>
                                    <ListView.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[Queue_PlayNow], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      Command="{Binding PlacementTarget.DataContext.PlayQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.SelectedQueueItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                            <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[Queue_MoveUp], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      Command="{Binding PlacementTarget.DataContext.MoveSelectedQueueItemUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                            <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[Queue_MoveDown], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      Command="{Binding PlacementTarget.DataContext.MoveSelectedQueueItemDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[Queue_RemoveFromQueue], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      Command="{Binding PlacementTarget.DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      CommandParameter="{Binding PlacementTarget.DataContext.SelectedQueueItem, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                            <MenuItem Header="{Binding PlacementTarget.DataContext.Loc[Queue_ClearUpcoming], RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                                      Command="{Binding PlacementTarget.DataContext.ClearUpcomingQueueCommand, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                                        </ContextMenu>
                                    </ListView.ContextMenu>
                                    <ListView.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource SelectedBackgroundColor}"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource TextStrongColor}"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource SelectedBackgroundColor}"/>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource TextStrongColor}"/>
                                    </ListView.Resources>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListViewItem}">
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextStrongBrush}"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="FocusVisualStyle" Value="{StaticResource MimiFocusVisualStyle}"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding PositionLabel}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontWeight="Bold" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Width="30" Height="30" CornerRadius="5" ClipToBounds="True"
                                                        Background="{StaticResource CoverGradientBrush}" VerticalAlignment="Center">
                                                    <Grid>
                                                        <TextBlock Text="♫" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                                                   Opacity="0.85" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Image Source="{Binding Track.CoverThumbnailPath}"
                                                               Width="30" Height="30" Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Clip>
                                                                <RectangleGeometry Rect="0,0,30,30" RadiusX="5" RadiusY="5"/>
                                                            </Image.Clip>
                                                        </Image>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" Margin="7,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Track.Title}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Track.Title}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Track.Artist}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Track.Artist}"/>
                                                        <TextBlock Grid.Column="1" Text=" · "
                                                                   Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Track.DurationLabel}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="10"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="180" Margin="12" IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUpcomingQueueItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Image Source="pack://application:,,,/Assets/Mascot/mimi-mascot-v1.png"
                                           Width="48" Height="64" Stretch="Uniform"
                                           Style="{StaticResource MascotFloatImageStyle}" Opacity="0.94"
                                           HorizontalAlignment="Center"
                                           AutomationProperties.Name="{Binding Loc[Mascot_Automation]}">
                                        <Image.RenderTransform>
                                            <TranslateTransform/>
                                        </Image.RenderTransform>
                                    </Image>
                                    <TextBlock Text="{Binding Loc[Queue_EmptyState]}"
                                               Foreground="{StaticResource TextFaintBrush}" FontSize="11"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Loc[Queue_EmptyHint]}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,7,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUpcomingQueueItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <UniformGrid Columns="4" Margin="0,8,0,0">
                                    <Button Command="{Binding PlayQueueItemCommand}"
                                            CommandParameter="{Binding SelectedQueueItem}"
                                            Padding="4,6" Margin="1"
                                            ToolTip="{Binding Loc[Common_Play]}"
                                            AutomationProperties.Name="{Binding Loc[Queue_PlaySelectedAutomation]}">
                                        <Path Data="{StaticResource PlayIconGeometry}" Style="{StaticResource IconPathStyle}"
                                              Width="15" Height="15"/>
                                    </Button>
                                    <Button Content="↑" Command="{Binding MoveSelectedQueueItemUpCommand}"
                                            Padding="4,6" Margin="1" FontSize="11"
                                            ToolTip="{Binding Loc[Queue_MoveSelectedUp]}"
                                            AutomationProperties.Name="{Binding Loc[Queue_MoveSelectedUp]}"/>
                                    <Button Content="↓" Command="{Binding MoveSelectedQueueItemDownCommand}"
                                            Padding="4,6" Margin="1" FontSize="11"
                                            ToolTip="{Binding Loc[Queue_MoveSelectedDown]}"
                                            AutomationProperties.Name="{Binding Loc[Queue_MoveSelectedDown]}"/>
                                    <Button Command="{Binding RemoveQueueItemCommand}"
                                            CommandParameter="{Binding SelectedQueueItem}"
                                            Padding="4,6" Margin="1"
                                            ToolTip="{Binding Loc[Common_Remove]}"
                                            AutomationProperties.Name="{Binding Loc[Queue_RemoveSelectedAutomation]}">
                                        <Path Data="{StaticResource DeleteIconGeometry}" Style="{StaticResource IconPathStyle}"
                                              Width="15" Height="15"/>
                                    </Button>
                                </UniformGrid>
                                <Button Content="{Binding Loc[Queue_ClearUpcoming]}" Command="{Binding ClearUpcomingQueueCommand}"
                                        Padding="8,6" Margin="1,4,1,0" FontSize="10"
                                        AutomationProperties.Name="{Binding Loc[Queue_ClearUpcomingAutomation]}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource RaisedBackgroundBrush}" CornerRadius="10" Padding="10" Margin="0,18,0,0">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding Loc[Settings_StageEngineSection]}" Foreground="{StaticResource AccentSecondaryBrush}" FontSize="10" FontWeight="Bold" DockPanel.Dock="Left"/>
                                    <TextBlock Text="{Binding VisualizerMetricsLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <UniformGrid Columns="3" Margin="0,8,0,0">
                                    <Button Content="{Binding Loc[Stage_ModeSpectrum]}" Command="{Binding SelectSpectrumModeCommand}"
                                            Style="{StaticResource SpectrumModeButtonStyle}"
                                            AutomationProperties.Name="{Binding Loc[Stage_ModeSpectrumAutomation]}"/>
                                    <Button Content="{Binding Loc[Stage_ModeTwinWave]}" Command="{Binding SelectTwinWaveModeCommand}"
                                            Style="{StaticResource TwinWaveModeButtonStyle}"
                                            AutomationProperties.Name="{Binding Loc[Stage_ModeTwinWaveAutomation]}"/>
                                    <Button Content="{Binding Loc[Stage_ModeHalo]}" Command="{Binding SelectHaloModeCommand}"
                                            Style="{StaticResource HaloModeButtonStyle}"
                                            AutomationProperties.Name="{Binding Loc[Stage_ModeHaloAutomation]}"/>
                                </UniformGrid>
                                <Button Command="{Binding ToggleStageCommand}" Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                                        FontWeight="Bold" Padding="10,8" Margin="2,8,2,2"
                                        AutomationProperties.Name="{Binding Loc[Stage_OpenAutomation]}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource ExpandIconGeometry}" Style="{StaticResource IconPathStyle}"/>
                                        <TextBlock Text="{Binding Loc[Stage_Open]}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="4,14,4,0" LastChildFill="False">
            <TextBlock Text="{Binding Loc[Footer_EarlyBuild]}" Foreground="{StaticResource TextFaintBrush}" FontSize="10" DockPanel.Dock="Left"/>
            <TextBlock Text="{Binding Loc[Footer_PersonalMusicSpace]}" Foreground="{StaticResource TextFaintBrush}" FontSize="10" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
