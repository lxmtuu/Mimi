                                    <wv2:WebView2 x:Name="YouTubeBrowser" Grid.Row="1" Margin="0,0,0,0"
                                                  MinWidth="200" MinHeight="200"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding NowPlayingTitle}" FontSize="17" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"/>
